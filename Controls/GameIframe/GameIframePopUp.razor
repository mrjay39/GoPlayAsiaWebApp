@page "/play"
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Goplay.Shared.Popup
@using GoPlayAsiaWebApp.Pages.GPAGames
@using GoPlayAsiaWebApp.Shared
@inject NavigationManager _navigationManager
@inject IModalService ModalService
@inject LobbyViewModel lobbyViewModel
@inject IJSRuntime JSRuntime
@attribute [Authorize(Roles = "1")]
@layout GPALayout

<div id="gameContainer" class="container">
    <div id="gamePopUp" class="modal-dialog modal-dialog-centered fixed-centered">
        <div class="modal-content modal-bg border-bottom-4 bg-transparent">
            @if (!string.IsNullOrEmpty(gameUrl))
            {
                <div class="modal-body text-center text-dark p-0 m-auto">
                    <div class="modal-header p-0" id="gamePopUpModalLabel">
                        <div class="d-flex w-100 btn-header row btn-hide">
                            <button class="btn col-xl-2 col-2 bg-transparent text-demo"><i class="fa-solid fa-play"></i> DEMO</button>
                            <button class="btn col-xl-2 col-2 bg-transparent text-live"><i class="fa-solid fa-play"></i> LIVE</button>
                        </div>
                        <button type="button" class="btn" @onclick="Close">
                            <i class="fa-regular close-icon"></i>
                        </button>
                    </div>
                    <iframe id="myIframe" src="@gameUrl" title="GoPlayAsia Game">
                    </iframe>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string gameUrl { get; set; } = string.Empty;

    [CascadingParameter]
    public IModalService popupModal { get; set; }

    private IModalReference popupRef;

    private async Task Close()

    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }
    protected override Task OnAfterRenderAsync(bool firstRender)

    {
        if (firstRender)
        {
            popupRef = popupModal.Show<PopupLoading>("");
            gameUrl = lobbyViewModel.egameUrl;
            StateHasChanged();
            Task.Delay(1000);
            popupRef.Close();
        }
        return base.OnAfterRenderAsync(firstRender);
    }
}
