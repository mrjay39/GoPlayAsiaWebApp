@page "/play"
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.GPAGames
@inject NavigationManager _navigationManager
@inject IModalService ModalService
@inject LobbyViewModel lobbyViewModel
@inject IJSRuntime JSRuntime

<div id="gameContainer" class="container">
    <div id="gamePopUp" class="modal-dialog modal-dialog-centered fixed-centered">
        <div class="modal-content modal-bg border-bottom-4 bg-transparent">
            @if (!string.IsNullOrEmpty(gameUrl))
            {
                <div class="modal-body text-center text-dark p-0">
                    <div class="modal-header p-2" id="gamePopUpModalLabel">
                        <button type="button" class="btn-close" @onclick="Close">
                            <i class="fa-regular close-icon"></i>
                        </button>
                    </div>
                    <iframe src="@gameUrl" title="GoPlayAsia Game">
                    </iframe>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string gameUrl { get; set; } = string.Empty;
    private async Task Close()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            gameUrl = lobbyViewModel.egameUrl;
            StateHasChanged();
        }
        return base.OnAfterRenderAsync(firstRender);
    }
}