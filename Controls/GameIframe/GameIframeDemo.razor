@page "/playdemo"
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Goplay.Shared.Popup
@using GoPlayAsiaWebApp.Pages.GPAGames
@inject NavigationManager _navigationManager
@inject IModalService ModalService
@inject LobbyViewModel lobbyViewModel
@inject IJSRuntime JSRuntime
@using GoPlayAsiaWebApp.Shared
@layout GPALayout

<div id="gameContainer" class="container bg-transparent">
    <div id="gamePopUp" class="modal-dialog modal-dialog-centered fixed-centered bg-transparent">
        <div class="modal-content modal-bg bg-transparent">
            <PopupLoading />
            @if (!string.IsNullOrEmpty(gameUrl))
            {
                <div class="modal-body text-center text-dark p-0 m-auto">
                    @* <div class="modal-header p-0" id="gamePopUpModalLabel">
                <div class="d-flex w-100 btn-header row btn-hide">
                <button class="btn col-xl-2 col-2 bg-transparent text-demo"><i class="fa-solid fa-play"></i> DEMO</button>
                <button class="btn col-xl-2 col-2 bg-transparent text-live"><i class="fa-solid fa-play"></i> LIVE</button>
                </div>
                </div> *@
                    <button type="button" class="btn close-icon p-0 @(lobbyViewModel._icurrentUser.isApple ? "appleCloseIcon": "")" @onclick="Close">
                        <i class="fa-regular fw-bold   ">X</i>
                    </button>
                    <iframe id="myIframe" class=" @(lobbyViewModel._icurrentUser.isApple ? "applePadding": "")  " src="@gameUrl" title="GoPlayAsia Game">
                    </iframe>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string gameUrl { get; set; } = string.Empty;

    [CascadingParameter]
    public IModalService popupModal { get; set; }

    private IModalReference popupRef;
    public async Task FullScreen()
    {
        try
        {
            await JSRuntime.InvokeAsync<bool>(identifier: "openFS");
        }
        catch (Exception)
        {

        }

    }

    private async Task Close()
    {
        var parameters = new ModalParameters();
        parameters.Add("Message", "Do you want to exit game?");
        var popupConfirm = popupModal.Show<PopupGlobalConfirm>("", parameters, new ModalOptions() { Class = "op-modal" });
        ModalResult result = await popupConfirm.Result;
        if (result.Data != null)
        {
            if ((bool)result.Data)
            {
                var backURL = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "backURL");
                if (!string.IsNullOrEmpty(backURL))
                {
                    _navigationManager.NavigateTo(backURL);
                }
                else
                {
                    await JSRuntime.InvokeVoidAsync("history.back");
                }
            }
        }



    }
    protected override async Task OnAfterRenderAsync(bool firstRender)

    {
        if (firstRender)
        {
            await FullScreen();
            JSRuntime.InvokeVoidAsync("chatScriptHelper.removeScript");
            if (string.IsNullOrEmpty(lobbyViewModel.egameUrl))
            {
                _navigationManager.NavigateTo("/GameProviders");
            }
            else
            {
                popupRef = popupModal.Show<PopupLoading>("");
                gameUrl = lobbyViewModel.egameUrl;
                StateHasChanged();
                Task.Delay(1000);
                popupRef.Close();
            }

        }
         base.OnAfterRenderAsync(firstRender);
    }
}
