<div id="ageAgreementOverlay" class="overlay"></div>
<div id="ageAgreement" class="modal-dialog modal show modal-dialog-centered fixed-centered" data-keyboard="false" data-backdrop="static">
    <div class="modal-content modal-bg border-bottom-4 position-relative">
        <div class="header p-2 text-end position-absolute float-right" id="ageConfirmModalLabel" style="right: 0; z-index: 10;">
            <button type="button" class="border-0 bg-transparent" aria-label="Close" @onclick="Close">
                <span aria-hidden="true" class="text-muted">
                    <i class="fa-solid fa-square-xmark"></i>
                </span>
            </button>
        </div>
        <div class="modal-body text-center text-dark">
            <div class="col text-center">
                <img src="./img/gpa-logo-2.png" class="img-fluid">
            </div>
            <h3 class="fw-bold gpa-text m-0">NOTICE</h3>
            <div class="d-flex justify-content-center">
                <div class="row">
                    <p class="p-2 m-0 text-13">
                        <span>We encourage you to thoroughly review our</span>
                        <a href="./img/docs/Responsible Gaming Policy.pdf" class="text-decoration-none fw-bold" target="_blank">Responsible Gaming</a>
                        <span>guidelines.</span>
                    </p>
                    <div class="d-flex text-center justify-content-center">
                        <ul class="text-12 p-2">
                            <li class="text-start list-unstyled">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="IsOver21" id="age21">
                                    <label class="form-check-label" for="age21">
                                        <span> I am over 21 years of age.</span>
                                    </label>
                                </div>
                            </li>
                            <li class="text-start list-unstyled">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="IsNotGovernmentOfficial" id="notGovernmentOfcl">
                                    <label class="form-check-label" for="notGovernmentOfcl">
                                        <span>
                                            I am neither a government official nor an employee directly involved in the operation of any government agency or its subdivisions. Additionally, I am not a member of the Armed Forces of the Philippines, including the Army, Navy, Air Force, or the Philippine National Police.
                                        </span>
                                    </label>
                                </div>
                            </li>
                            <li class="text-start list-unstyled">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="IsNotGamingEmployment" id="gamingEmployment">
                                    <label class="form-check-label" for="gamingEmployment">
                                        <span> I am not a Gaming Employment License (GEL) holder.</span>
                                    </label>
                                </div>
                            </li>
                            <li class="text-start list-unstyled">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="AgreedToTerms" id="termsOfUse">
                                    <label class="form-check-label" for="termsOfUse">
                                        <span>
                                            You agree to our
                                            <a href="https://docs.goplayasia.com/toc.html" class="text-decoration-none fw-bold">Terms of Use.</a>
                                        </span>
                                    </label>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="container pt-2">
                <button class="btn gpa-btn fw-bold" @onclick="Agree" disabled="@(!IsFormValid)">Proceed</button>
            </div>
        </div>
        <div class="modal-footer text-dark">
            <div class="d-flex justify-content-center">
                <div class="col text-center">
                    <img src="./img/Pagcor-21-black.png" class="img-fluid">
                </div>
            </div>
            <p style="text-align: center;">GoPlayAsia Remote Gaming Site is approved and regulated by PAGCOR.</p>
        </div>
    </div>
</div>

@code {
    private bool IsOver21 { get; set; } = true;
    private bool IsNotGovernmentOfficial { get; set; } = true;
    private bool IsNotGamingEmployment { get; set; } = true;
    private bool AgreedToTerms { get; set; } = true;

    private bool IsFormValid => IsOver21 && IsNotGovernmentOfficial && IsNotGamingEmployment && AgreedToTerms;

    private async Task Agree()
    {
        await OnAgree.InvokeAsync();
    }
    [Parameter] public EventCallback OnAgree { get; set; }


    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;

    [Parameter] public string? Message { get; set; }

    private async Task Close() => await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    private async Task Cancel() => await BlazoredModal.CancelAsync();
}
