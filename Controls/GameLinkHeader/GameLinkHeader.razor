<div id="headerContainer" class="row pt-4">
    <h2 class="text-white fw-bold mt-3 base">Game Categories</h2>
    <h5 class="text-muted"> Navigating the World of Gaming Genres</h5>
    <div id="link-header" class="p-0 gameOverflow-x">
        <div class="row p-0 d-flex container-fluid justify-content-center centered m-auto">

            <GameLinkHeaderTile _gameHrefStr="#gpaGames"
                                _idStr="fishing-linkHeader"
                                _imgGameStr="gpaGames"
                                _typeGameStr="Specialty" />
       
            <GameLinkHeaderTile _gameHrefStr="#liveGames"
                            _idStr="gpa-linkHeader"
                                _imgGameStr="liveGames"
                            _typeGameStr="Live" />

            <GameLinkHeaderTile _gameHrefStr="#arcadeGames"
                            _idStr="arcade-linkHeader"
                                _imgGameStr="arcadeGames"
                            _typeGameStr="arcade" />

            <GameLinkHeaderTile _gameHrefStr="#slotGames"
                            _idStr="slots-linkHeader"
                                _imgGameStr="slotGames"
                            _typeGameStr="Slots" />

            <GameLinkHeaderTile _gameHrefStr="#cardGames"
                            _idStr="card-linkHeader"
                                _imgGameStr="cardGames"
                            _typeGameStr="Cards" />
        </div>

    </div>
</div>
<script>
    $(document).ready(function () {
        $('#link-header a').click(function (e) {
            $('#navBarBottom a').removeClass('active');

        });

        $('#link-header a').click(function (event) {
            var targetSelector = $(this).attr('href');
            $('#liveGames, #slotGames, #cardGames, #arcadeGames, #gpaGames').removeClass('pt-8 pt-5');
            $(targetSelector).addClass('pt-8');
        });
        
        $('#link-header .bg-linkHeader').click(function () {
            $('.bg-linkHeader').removeClass('active');
            $(this).addClass('active');
        });

        @*===== Sticky Category =====*@
        var $linkHeader = $('#link-header');
        var $headerContainer = $('h2.base');
        var containerTop = $headerContainer.offset().top;
        var headerHeight = $linkHeader.outerHeight();

        $linkHeader.before('<div class="sticky-placeholder"></div>');
        var $stickyPlaceholder = $('.sticky-placeholder');

        $(window).on('scroll', function () {
            var scrollTop = $(this).scrollTop();

            if (scrollTop >= containerTop) {
                $linkHeader.addClass('sticky');
                $stickyPlaceholder.css('height', headerHeight + 'px');
            } else {
                $linkHeader.removeClass('sticky');
                $stickyPlaceholder.css('height', '0');
            }
        });
       
    });
</script>