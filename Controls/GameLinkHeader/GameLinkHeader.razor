<div class="container pt-4">
    <h2 class="text-white fw-bold mt-3">Game Categories</h2>
    <h5 class="text-muted"> Navigating the World of Gaming Genres</h5>
    <div id="link-header" class="pb-2 gameOverflow-x">
        <div class="row justify-content-center">
       
            <GameLinkHeaderTile _gameHrefStr="#liveGames"
                            _idStr="gpa-linkHeader"
                                _imgGameStr="./img/gameCategory/liveWebp.webp"
                            _typeGameStr="Live" />

            <GameLinkHeaderTile _gameHrefStr="#arcadeGames"
                            _idStr="arcade-linkHeader"
                                _imgGameStr="./img/gameCategory/arcade.webp"
                            _typeGameStr="arcade" />

            <GameLinkHeaderTile _gameHrefStr="#slotGames"
                            _idStr="slots-linkHeader"
                                _imgGameStr="./img/gameCategory/slot.gif"
                            _typeGameStr="Slots" />

            <GameLinkHeaderTile _gameHrefStr="#cardGames"
                            _idStr="card-linkHeader"
                                _imgGameStr="./img/gameCategory/card.webp"
                            _typeGameStr="Cards" />

            <GameLinkHeaderTile _gameHrefStr="#fishingGames"
                            _idStr="fishing-linkHeader"
                                _imgGameStr="./img/gameCategory/fish.gif"
                            _typeGameStr="Fishing" />
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#link-header a').click(function (e) {
            $('#navBarBottom a').removeClass('active');

        });

        $('#link-header > a').click(function (event) {
            var targetSelector = $(this).attr('href');
            $('#liveGames, #slotGames, #cardGames, #arcadeGames, #fishingGames').removeClass('pt-5');
            $(targetSelector).addClass('pt-5');
        });
        
        $('.link-header .bg-linkHeader').click(function () {
            $('.bg-linkHeader').removeClass('active');
            $(this).addClass('active'); 
            var container = $(this).closest('.link-header');
            container.parent().prepend(container);
        });
        
       
    });
</script>