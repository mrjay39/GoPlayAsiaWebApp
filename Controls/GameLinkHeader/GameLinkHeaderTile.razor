<div class="col col-xl-2">
    <a id="@_idStr" href="@_gameHrefStr" class="text-decoration-none" style="width: 12rem;">
        <div class="bg-linkHeader text-center  rounded-3 @_activeClassStr d-flex justify-content-center align-items-center">
            <div class="img img-fluid mb-1 @_imgGameStr @(_activeClassStr == "active"  ? "activeIcon" : "deactiveIcon")"></div>
            <h6 class="text-uppercase fw-bold mb-1 mt-1 header-title">@_typeGameStr</h6>
        </div>
    </a>
</div>
@code {
   
    [Parameter]
    public string _gameHrefStr { get; set; }
    [Parameter]
    public string _imgGameStr { get; set; }
    [Parameter]
    public string _typeGameStr { get; set; }
    [Parameter]
    public string _activeClassStr { get; set; }
    [Parameter]
    public string _idStr { get; set; }
}