<div id="link-header" class="link-header p-0 m-2">
    <a href="@_gameHrefStr" class="text-decoration-none" style="width: 12rem;">
        <div id="@_idStr" class="bg-linkHeader text-center  rounded-3 @_activeClassStr">
            <img  src="@_imgGameStr" class=" img-fluid mb-1 @(_activeClassStr == "active"  ? "activeIcon" : "deactiveIcon")" alt="GoPlayAsia">

            <h6 class="text-uppercase fw-bold mb-1 mt-1 header-title">@_typeGameStr</h6>
        </div>
    </a>
</div>
@code {
   
    [Parameter]
    public string _gameHrefStr { get; set; }
    [Parameter]
    public string _imgGameStr { get; set; }
    [Parameter]
    public string _typeGameStr { get; set; }
    [Parameter]
    public string _activeClassStr { get; set; }
    [Parameter]
    public string _idStr { get; set; }
}
