@using GoPlayAsiaWebApp.Controls.HeaderAndFooter
@using GoPlayAsiaWebApp.Controls.SearchField
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.GamesList.GameSlotList
@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@using static GoplayasiaBlazor.Models.Constants.Settings
@inject LobbyViewModel _lobbyViewModel;

<div class="container p-0 mt-2 text-center">

    <SearchField _titleStr="Game Providers"
                 _subTitleStr="Choose Your Preferred Game Provider"
    />

    <div id="link-header" class="pb-2 gameOverflow-x text-start">
        <div class="d-flex justify-content-center">
            @if(_lobbyViewModel.gameProviders != null){   
                @foreach (var provider in _lobbyViewModel.gameProviders)
                {
                    if (provider.SlotsCount > 0)
                    {
                        <div @onclick="@(e => ToggleSelection(provider.Name))" class="link-header p-0 @GetSelectionClass(provider.Name)
                        ">
                            <div class="text-mute btn p-0">
                                <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                                    <img src="./img/providersLogo/@provider.ImageUrl" class="img-fluid mb-1" style="">
                                </div>
                            </div>
                        </div>
                    }
                }
            }

        </div>
    </div>
</div>

<GameSLotList _idStr="slotGames" _title="@Constants.SlotsGameTitle" _description="@Constants.SlotsGameDescription" _filter="@Constants.egamesSlots" _provider="@activeProvider" />
@code {

    // Track which filter is currently active
    private string activeProvider = "All";
    private void ToggleSelection(string provider)
    {
        _lobbyViewModel.gameProviders.ForEach(x => x.Selected = false);
        _lobbyViewModel.gameProviders.Where(x => x.Name == provider)
             .ToList()
             .ForEach(x => x.Selected = true);

        activeProvider = provider;
    }
    private string GetSelectionClass(string provider)
    {
        var selected = _lobbyViewModel.gameProviders.Where(x => x.Name == provider).Select(x => x.Selected).SingleOrDefault();
        return selected ? "selected" : "";
    }
}