@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.GamesList.GameSlotList
@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@using static GoplayasiaBlazor.Models.Constants.Settings

<div class="container p-0 mt-2 text-center">
    <h2 class="text-white fw-bold mt-1">Game Providers</h2>
    <h5 class="text-muted">Choose Your Preferred Game Provider</h5>
    <div id="link-header" class="pb-2 gameOverflow-x">
        <div class="row justify-content-center">

            @foreach (var provider in providers)
            {
                <div @onclick="@(e => ToggleSelection(provider.Key))" class="link-header p-0 m-2 @GetSelectionClass(provider.Key)">
                    <div class="text-mute btn p-0" style="width: 6rem;">
                        <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                            @if (provider.Value)
                            {
                                <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                            }
                            <img src="./img/providersLogo/@GetProviderImage(provider.Key)" class="img-fluid w-100 mb-1" style="">
                            <h6 class="text-uppercase fw-bold mb-0">@provider.Key</h6>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<GameSLotList _idStr="slotGames" _title="@Constants.SlotsGameTitle" _description="@Constants.SlotsGameDescription" _filter="@Constants.egamesSlots" _provider="@activeProvider" />
@code {

    private Dictionary<string, bool> providers = new Dictionary<string, bool>
    {
        { "All", true },
        { "Pragmatic", false },
        { "Evolution", false },
        { "NetEnt", false },
        { "Red Tiger", false },
        { "Big Time Gaming", false }
    };

    // Track which filter is currently active
    private string activeProvider = "All";
    private void ToggleSelection(string provider)
    {
        foreach (var key in providers.Keys.ToList())
        {
            providers[key] = false;
        }
        providers[provider] = true;
        activeProvider = provider;
    }
    private string GetSelectionClass(string provider)
    {
        return providers[provider] ? "selected" : "";
    }

    private string GetProviderImage(string provider)
    {
        return provider switch
        {
            "All" => "provider-all.png",
            "Pragmatic" => "pragmatic.png",
            "Evolution" => "evolution.png",
            "NetEnt" => "netent.png",
            "Red Tiger" => "redTiger.png",
            "Big Time Gaming" => "bigTime.png",
            _ => ""
        };
    }
}