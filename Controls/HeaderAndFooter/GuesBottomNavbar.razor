@inject NavigationManager NavigationManager
<nav class="navbar navbar-expand-lg navbar-dark bg-black sticky-bottom-navbar">
    <div id="navBarBottom" class="container">
        <a href="/home" class="navbar-brand text-center text-muted active home">
            <div class="icon">
                <i class="fa-solid home-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Home</span>
            </div>
        </a>
        <a id ="liveGames" href="/@currentPage#liveGames" class="navbar-brand text-center text-muted home">
            <div class="icon">
                <i class="fa-solid gpa-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Live</span>
            </div>
        </a>
        <a id="slotGames" href="/@currentPage#slotGames" class="navbar-brand text-center text-muted">
            <div class="icon">
                <i class="fa-solid slot-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Slots</span>
            </div>
        </a>
        <a id="cardGames" href="/@currentPage#cardGames" class="navbar-brand text-center text-muted">
            <div class="icon">
                <i class="fa-solid card-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Cards</span>
            </div>
        </a>
        <a id="arcadeGames" href="/@currentPage#arcadeGames" class="navbar-brand text-center text-muted">
            <div class="icon">
                <i class="fa-solid arcade-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Arcade</span>
            </div>
        </a>
    </div>
</nav>

@code{
    private string currentPage = string.Empty;
    protected override void OnInitialized()
    {
        currentPage = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }
}
<script>
    $(document).ready(function () {
        $('#navBarBottom a').click(function (e) {
            $('#navBarBottom a').removeClass('active');
            $(this).addClass('active');
        });

        $('#navBarBottom > a').click(function (event) {
            var getId = $(this).attr('id');
            $('#liveGames, #slotGames, #cardGames, #arcadeGames, #fishingGames').removeClass('pt-8');
            if (getId) {
                $('#' + getId).addClass('pt-8');
            }
        });


    });
</script>