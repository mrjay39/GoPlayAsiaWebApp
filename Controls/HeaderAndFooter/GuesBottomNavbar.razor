@inject NavigationManager NavigationManager
<nav class="navbar navbar-expand-lg navbar-dark bg-black sticky-bottom-navbar">
    <div id="navBarBottom" class="container">
        <NavLink href="/home" class="navlink navbar-brand text-center text-muted home">
            <div class="icon">
                <i class="fa-solid home-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Home</span>
            </div>
        </NavLink>
        <NavLink id ="liveGames" href="@_hrefLiveGameStr" class="navlink navbar-brand text-center text-muted home">
            <div class="icon">
                <i class="fa-solid gpa-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Live</span>
            </div>
        </NavLink>
        <NavLink id="slotGames" href="@_hrefSlotGameStr" class="navlink navbar-brand text-center text-muted">
            <div class="icon">
                <i class="fa-solid slot-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Slots</span>
            </div>
        </NavLink>
        <NavLink id="cardGames" href="@_hrefCasinoGameStr" class="navlink navbar-brand text-center text-muted">
            <div class="icon">
                <i class="fa-solid card-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Casino</span>
            </div>
        </NavLink>
        <NavLink id="arcadeGames" href="@_hrefArcadeGameStr" class="navlink navbar-brand text-center text-muted">
            <div class="icon">
                <i class="fa-solid arcade-btm-icon"></i>
            </div>
            <div class="menuText">
                <span class="text-uppercase small">Arcade</span>
            </div>
        </NavLink>
    </div>
</nav>

@code{
    [Parameter] public string _hrefLiveGameStr { get; set; }
    [Parameter] public string _hrefCasinoGameStr { get; set; }
    [Parameter] public string _hrefSlotGameStr { get; set; }
    [Parameter] public string _hrefArcadeGameStr { get; set; }

    private string currentPage = string.Empty;
    protected override void OnInitialized()
    {
        currentPage = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    }
}
