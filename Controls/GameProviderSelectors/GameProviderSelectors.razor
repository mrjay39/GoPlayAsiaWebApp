@using GoPlayAsiaWebApp.Pages.EGames.ArcadeGames
@using GoPlayAsiaWebApp.Pages.EGames.CardGames
@using GoPlayAsiaWebApp.Pages.EGames.FishingGames
@using GoPlayAsiaWebApp.Pages.EGames.LiveCasino
@using GoPlayAsiaWebApp.Pages.EGames.SlotGames

<div class="container pt-4">
    <h2 class="text-white fw-bold mt-3">Game Providers</h2>
    <h5 class="text-muted">Choose Your Preferred Game Provider</h5>
    <div id="link-header" class="pb-2 gameOverflow-x">
        <div class="row justify-content-center">

            <div @onclick="@(e => ToggleSelection("1"))" class="link-header p-0 m-2 @GetSelectionClass("1")">
                <div class="text-warning btn p-0" style="width: 12rem;">
                    <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                        @if (IsSelected("1"))
                        {
                            <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                        }
                        <img src="./img/providersLogo/pragmatic.png" class="img-fluid w-100" alt="GoPlayAsia">
                        <h6 class="text-uppercase fw-bold mb-0">Pragmatic</h6>
                    </div>
                </div>
            </div>

            <div @onclick="@(e => ToggleSelection("2"))" class="link-header p-0 m-2 @GetSelectionClass("2")">
                <div class="text-warning btn p-0" style="width: 12rem;">
                    <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                        @if (IsSelected("2"))
                        {
                            <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                        }
                        <img src="./img/providersLogo/evolution.png" class="img-fluid w-100" alt="GoPlayAsia">
                        <h6 class="text-uppercase fw-bold mb-0">Evolution</h6>
                    </div>
                </div>
            </div>

            <div @onclick="@(e => ToggleSelection("3"))" class="link-header p-0 m-2 @GetSelectionClass("3")">
                <div class="text-warning btn p-0" style="width: 12rem;">
                    <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                        @if (IsSelected("3"))
                        {
                            <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                        }
                        <img src="./img/providersLogo/SAGaming.png" class="img-fluid w-100" alt="GoPlayAsia">
                        <h6 class="text-uppercase fw-bold mb-0">SA Gaming</h6>
                    </div>
                </div>
            </div>

            <div @onclick="@(e => ToggleSelection("4"))" class="link-header p-0 m-2 @GetSelectionClass("4")">
                <div class="text-warning btn p-0" style="width: 12rem;">
                    <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                        @if (IsSelected("4"))
                        {
                            <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                        }
                        <img src="./img/providersLogo/aviatrix.png" class="img-fluid w-100" alt="GoPlayAsia">
                        <h6 class="text-uppercase fw-bold mb-0">Aviatrix</h6>
                    </div>
                </div>
            </div>

            <div @onclick="@(e => ToggleSelection("5"))" class="link-header p-0 m-2 @GetSelectionClass("5")">
                <div class="text-warning btn p-0" style="width: 12rem;">
                    <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                        @if (IsSelected("5"))
                        {
                            <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                        }
                        <img src="./img/providersLogo/jili.png" class="img-fluid w-100" alt="GoPlayAsia">
                        <h6 class="text-uppercase fw-bold mb-0">Jili</h6>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@if (selectedProviders.Any())
{
    <div>
        @foreach (var provider in selectedProviders)
        {
            if (provider == "1")
            {
                <LiveCasino />
            }
            else if (provider == "2")
            {
                <CardGames />
            }
            else if (provider == "3")
            {
                <ArcadeGames />
            }
            else if (provider == "4")
            {
                <FishingGames />
            }
            else if (provider == "5")
            {
                <SlotsGames />
            }
        }
    </div>
}

@code {
    private List<string> selectedProviders = new List<string> { "1", "2", "3", "4", "5" }; // All selected by default

    private void ToggleSelection(string provider)
    {
        if (IsSelected(provider))
        {
            selectedProviders.Remove(provider);
        }
        else
        {
            selectedProviders.Add(provider);
        }
    }

    private bool IsSelected(string provider)
    {
        return selectedProviders.Contains(provider);
    }

    private string GetSelectionClass(string provider)
    {
        return IsSelected(provider) ? "selected" : "";
    }
}