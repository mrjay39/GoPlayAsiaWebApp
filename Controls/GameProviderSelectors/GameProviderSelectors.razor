@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.ArcadeGames
@using GoPlayAsiaWebApp.Pages.EGames.CardGames
@using GoPlayAsiaWebApp.Pages.EGames.FishingGames
@using GoPlayAsiaWebApp.Pages.EGames.LiveCasino
@using GoPlayAsiaWebApp.Pages.EGames.SlotGames

@using GoPlayAsiaWebApp.Pages.EGames.GamesList
@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@using static GoplayasiaBlazor.Models.Constants.Settings

<div class="container p-0 mt-2 text-center">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-9">
                <h2 class="text-white fw-bold mt-1 text-start">Game Providers</h2>
                <h5 class="text-muted text-start">Choose Your Preferred Game Provider</h5>
            </div>
            <div class="col-md-3">
                <form id="searchForm" class="d-flex" role="search">
                    <input @bind="searchText" @bind:event="oninput" class="form-control bg-dark text-white border-0 col-12" type="search" placeholder="Search your game" aria-label="Search">
                    <span class="position-relative rounded-1 r-40">
                        <button class="btn text-muted" type="submit"><i class="@(searchText.Length > 0 ? "fa fa-trash" : "fa fa-magnifying-glass")"></i></button>
                    </span>
                </form>
            </div>
        </div>
    </div>
    <div id="link-header" class="pb-2 gameOverflow-x">
        <div class="row justify-content-center">

            @foreach (var provider in providers)
            {
                <div @onclick="@(e => ToggleSelection(provider.Key))" class="link-header p-0 m-2 @GetSelectionClass(provider.Key)">
                    <div class="text-mute btn p-0" style="width: 6rem;">
                        <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                            @if (provider.Value)
                            {
                                <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                            }
                            <img src="./img/providersLogo/@GetProviderImage(provider.Key)" class="img-fluid w-100 mb-1" style="">
                            <h6 class="text-uppercase fw-bold mb-0">@provider.Key</h6>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<GamesList _idStr="liveGames" _title="@Constants.CasinoGameTitle" _description="@Constants.CasinoGameDescription" _filter="@Constants.egamesLive" _provider="@activeProvider" />
<GamesList _idStr="slotGames" _title="@Constants.SlotsGameTitle" _description="@Constants.SlotsGameDescription" _filter="@Constants.egamesSlots" _provider="@activeProvider" />
<GamesList _idStr="arcadeGames" _title="@Constants.ArcadeGameTitle" _description="@Constants.ArcadeDescription" _filter="@Constants.egamesRng" _provider="@activeProvider" />
<GamesList _idStr="cardGames" _title="@Constants.CardGameTitle" _description="@Constants.CardGameDescription" _filter="@Constants.egamesCards" _provider="@activeProvider" />
@code {

    private Dictionary<string, bool> providers = new Dictionary<string, bool>
    {
        { "All", true },
        { "Pragmatic", false },
        { "Evolution", false },
        { "NetEnt", false },
        { "Red Tiger", false },
        { "Big Time Gaming", false }
    };

    // Track which filter is currently active
    private string activeProvider = "All";
    private void ToggleSelection(string provider)
    {
        foreach (var key in providers.Keys.ToList())
        {
            providers[key] = false;
        }
        providers[provider] = true;
        activeProvider = provider;
    }
    private string GetSelectionClass(string provider)
    {
        return providers[provider] ? "selected" : "";
    }

    private string GetProviderImage(string provider)
    {
        return provider switch
        {
            "All" => "provider-all.png",
            "Pragmatic" => "pragmatic.png",
            "Evolution" => "evolution.png",
            "NetEnt" => "netent.png",
            "Red Tiger" => "redTiger.png",
            "Big Time Gaming" => "bigTime.png",
            _ => ""
        };
    }

    private string searchText = "";
    private void ClearSearch()
    {
        if (searchText.Length > 0)
        {
            searchText = "";
        }
    }
}