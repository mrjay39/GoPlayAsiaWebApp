@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.ArcadeGames
@using GoPlayAsiaWebApp.Pages.EGames.CardGames
@using GoPlayAsiaWebApp.Pages.EGames.FishingGames
@using GoPlayAsiaWebApp.Pages.EGames.LiveCasino
@using GoPlayAsiaWebApp.Pages.EGames.SlotGames

@using GoPlayAsiaWebApp.Pages.EGames.GamesList
@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@using static GoplayasiaBlazor.Models.Constants.Settings

<div class="container p-0 mt-4">
    <h2 class="text-white fw-bold mt-3">Game Providers</h2>
    <h5 class="text-muted">Choose Your Preferred Game Provider</h5>
    <div id="link-header" class="pb-2 gameOverflow-x">
        <div class="row justify-content-center">

            @foreach (var provider in providers)
            {
                <div @onclick="@(e => ToggleSelection(provider.Key))" class="link-header p-0 m-2 @GetSelectionClass(provider.Key)">
                    <div class="text-warning btn p-0" style="width: 12rem;">
                        <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                            @if (provider.Value)
                            {
                                <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                            }
                            <img src="./img/providersLogo/@GetProviderImage(provider.Key)" class="img-fluid w-100" alt="GoPlayAsia">
                            <h6 class="text-uppercase fw-bold mb-0">@GetProviderName(provider.Key)</h6>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@if (providers.Any(p => p.Value))
{
    <div id="gameList">
        @foreach (var provider in providers.Where(p => p.Value))
        {
            if (provider.Key == "1")
            {
                //<LiveCasino />
                <GamesList _idStr="liveGames" _title="@Constants.CasinoGameTitle" _description="@Constants.CasinoGameDescription" _filter="@Constants.egamesLive" />
             
            }
            else if (provider.Key == "2")
            {
                //<CardGames />
                <GamesList _idStr="cardGames" _title="@Constants.CardGameTitle" _description="@Constants.CardGameDescription" _filter="@Constants.egamesRng" />
                
            }
            else if (provider.Key == "3")
            {
                <ArcadeGames />
                //<GamesList _title="@Constants.ArcadeGameTitle" _description="@Constants.ArcadeGameDescription" _filter="@Constants.egamesLive" />
                               
            }
            else if (provider.Key == "4")
            {
                <FishingGames />
                //<GamesList _title="@Constants.FishingGameTitle" _description="@Constants.FishingGameDescription" _filter="@Constants.egamesFishing" />
                
            }
            else if (provider.Key == "5")
            {
                //<SlotsGames />
                <GamesList _idStr="slotGames" _title="@Constants.SlotsGameTitle" _description="@Constants.SlotsGameDescription" _filter="@Constants.egamesSlots" />
                
            }
        }
    </div>
}

@code {
    
    [CascadingParameter] public List<eGamesListDTO> LiveGameList { get; set; }

    private Dictionary<string, bool> providers = new Dictionary<string, bool>
    {
        { "1", true },
        { "2", true },
        { "3", true },
        { "4", true },
        { "5", true }
    };

    private void ToggleSelection(string provider)
    {
        providers[provider] = !providers[provider];
    }

    private bool IsSelected(string provider)
    {
        return providers[provider];
    }

    private string GetSelectionClass(string provider)
    {
        return IsSelected(provider) ? "selected" : "";
    }

    private string GetProviderName(string provider)
    {
        return provider switch
        {
            "1" => "Pragmatic",
            "2" => "Evolution",
            "3" => "SA Gaming",
            "4" => "Aviatrix",
            "5" => "Jili",
            _ => ""
        };
    }

    private string GetProviderImage(string provider)
    {
        return provider switch
        {
            "1" => "pragmatic.png",
            "2" => "evolution.png",
            "3" => "SAGaming.png",
            "4" => "aviatrix.png",
            "5" => "jili.png",
            _ => ""
        };
    }
}