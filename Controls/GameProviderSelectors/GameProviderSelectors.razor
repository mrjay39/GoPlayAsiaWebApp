@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.ArcadeGames
@using GoPlayAsiaWebApp.Pages.EGames.CardGames
@using GoPlayAsiaWebApp.Pages.EGames.FishingGames
@using GoPlayAsiaWebApp.Pages.EGames.LiveCasino
@using GoPlayAsiaWebApp.Pages.EGames.SlotGames

@using GoPlayAsiaWebApp.Controls.SearchField
@using GoPlayAsiaWebApp.Pages.EGames.GamesList
@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@using static GoplayasiaBlazor.Models.Constants.Settings
@inject LobbyViewModel _lobbyViewModel;

<div class="container p-0 mt-2 text-center">

    <SearchField _titleStr="Game Providers"
                 _subTitleStr="Choose Your Preferred Game Provider"
    />

    <div id="link-header" class="pb-2 gameOverflow-x">
        <div class="row justify-content-center">
            @if(_lobbyViewModel.gameProviders != null)
            {
                @foreach (var provider in _lobbyViewModel.gameProviders)
                {
                    <div @onclick="@(e => ToggleSelection(provider.Name))" class="link-header p-0 m-2 @GetSelectionClass(provider.Name)">
                        <div class="text-mute btn p-0" style="width: 6rem;">
                            <div class="bg-provider text-center p-1 m-1 rounded-3 position-relative">
                                @if (provider.Selected)
                                {
                                    <span class="selected-icon"><i class="fa-regular fa-circle-check"></i></span>
                                }
                                <img src="./img/providersLogo/@provider.ImageUrl" class="img-fluid w-100 mb-1" style="">
                                <h6 class="text-uppercase fw-bold mb-0">@provider.Name</h6>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<GamesList _idStr="liveGames" _title="@Constants.CasinoGameTitle" _description="@Constants.CasinoGameDescription" _filter="@Constants.egamesLive" _provider="@activeProvider" />
<GamesList _idStr="slotGames" _title="@Constants.SlotsGameTitle" _description="@Constants.SlotsGameDescription" _filter="@Constants.egamesSlots" _provider="@activeProvider" />
<GamesList _idStr="arcadeGames" _title="@Constants.ArcadeGameTitle" _description="@Constants.ArcadeDescription" _filter="@Constants.egamesRng" _provider="@activeProvider" />
<GamesList _idStr="cardGames" _title="@Constants.CardGameTitle" _description="@Constants.CardGameDescription" _filter="@Constants.egamesCards" _provider="@activeProvider" />
@code {
    private string activeProvider = "All";
    private void ToggleSelection(string provider)
    {
        _lobbyViewModel.gameProviders.ForEach(x => x.Selected = false);
        _lobbyViewModel.gameProviders.Where(x => x.Name == provider)
             .ToList()
             .ForEach(x => x.Selected = true);

        activeProvider = provider;
    }
    private string GetSelectionClass(string provider)
    {
        var selected = _lobbyViewModel.gameProviders.Where(x => x.Name == provider).Select(x => x.Selected).SingleOrDefault();
        return selected ? "selected" : "";
    }
}