@using GoplayasiaBlazor.Models.Constants
@using static GoplayasiaBlazor.Models.Constants.Settings
<table class="maincontainer bg-white pt-2 d-block rounded-3">
    <div class="btn-group px-2 d-flex justify-content-center" role="group" aria-label="Basic radio toggle button group">

        <input type="radio" class="btn-check" name="btnradio" id="btnRadio1" autocomplete="off" checked @onchange='(() => SetCategory(Settings.Constants.specialty))'>
        <label class="mxs-55 btn border-0 btn-outline-warning rounded-3 pt-1 text-dark col p-0 d-flex flex-column justify-content-center align-items-center" for="btnRadio1">
            <div>
                <img src="./img/GPA-btm-icon-2.svg" class="img img-fluid sw-25" style="width: 27px;">
            </div>
            <div><span class="f-13">Especialty</span></div>
        </label>

        <input type="radio" class="btn-check " name="btnradio" id="btnRadio2" autocomplete="off" @onchange='(() => SetCategory(Settings.Constants.egamesLive))'>
        <label class="mxs-55 btn border-0 btn-outline-warning rounded-3 pt-1 rounded-3 text-dark col p-0 d-flex flex-column justify-content-center align-items-center" for="btnRadio2">
            <div>
                <img src="./img/live-btm-icon.svg" class="img img-fluid sw-25" style="width: 27px;">
            </div>
            <div><span class="f-13">Live</span></div>
        </label>

        <input type="radio" class="btn-check p-0 d-flex justify-content-center align-items-center" name="btnradio" id="btnradio3" autocomplete="off" @onchange='(() => SetCategory(Settings.Constants.egamesSlots))'>
        <label class="mxs-55 btn border-0 btn-outline-warning rounded-3 pt-1 text-dark col p-0 d-flex flex-column justify-content-center align-items-center" for="btnradio3">
            <div><img src="./img/slot-btm-icon-2.svg" style="width: 27px;" class="img img-fluid sw-25"></div>
            <div><span class="f-13">Slots</span></div>
        </label>

        <input type="radio" class="btn-check p-0 d-flex justify-content-center align-items-center" name="btnradio" id="btnradio4" autocomplete="off" @onchange='(() => SetCategory(Settings.Constants.egamesCasino))'>
        <label class="mxs-55 btn border-0 btn-outline-warning rounded-3 pt-1 text-dark col p-0 d-flex justify-content-center flex-column align-items-center" for="btnradio4">
            <div><img src="./img/card-btm-icon-2.svg" style="width: 27px;" class="img img-fluid sw-25"></div>
            <div><span class="f-13">Casino</span></div>
        </label>

        <input type="radio" class="btn-check p-0 d-flex justify-content-center align-items-center" name="btnradio" id="btnradio5" autocomplete="off" @onchange='(() => SetCategory(Settings.Constants.egamesRng))'>
        <label class="mxs-55 btn btn-outline-warning border-0 rounded-3 pt-1 text-dark col p-0 d-flex justify-content-center flex-column align-items-center" for="btnradio5">
            <div><img src="./img/arcade-btm-icon-2.svg" style="width: 27px;" class="img img-fluid sw-25"></div>
            <div><span class="f-13">Arcade</span></div>
        </label>
    </div>
    <div class="d-flex justify-content-center px-2 mt-1">
        <input type="date" @bind="_compBetHistoryViewModel.SelDate" class="dateSearch" />
        <button class="btn btn-warning btn-sm dateSearchBtn" @onclick="onclick_Go">Go</button>
    </div>

    <tbody class="tableCon container bg-white rounded-3 pt-2" style="padding-bottom: 30px;">
        @if (_compBetHistoryViewModel.Category == Settings.Constants.specialty)
        {
        <thead class="row p-0 justify-content-center">
            <tr class="d-flex headerContainer">
                <th class="status col text-center">BET</th>
                <th class="status col text-center text-end"> GAME RESULT</th>
                <th class="winStatusContainer col text-end">WIN</th>
                <th class="winStatusContainer col text-center">
                    <div>PROFIT/LOSS</div>
                </th>
            </tr>
        </thead>
        }
        else
        {
        <thead class="row p-0 justify-content-center">
            <tr class="d-flex headerContainer">
                <th class="status col-5 text-center" style="width: 40%;">BET</th>
                <th class="winStatusContainer col text-end">WIN</th>
                <th class="winStatusContainer col text-end">
                    <div>PROFIT/LOSS</div>

                </th>
            </tr>
        </thead>
        }

        @if (_compBetHistoryViewModel.VisibleGameRounds != null)
        {
        <Virtualize Items="_compBetHistoryViewModel.VisibleGameRounds" Context="_gameround" OverscanCount="20">
                @if (_compBetHistoryViewModel.Category == Settings.Constants.specialty)
                {
                <tr class="beHistoryBg row mt-1 text-dark mr-0">
                    <td class="col-5 m-0 p-0">
                        <div class="lbl-header">@_gameround.GameTypeName</div>
                        <div class="history-dtl"><span class="lbl-header">Id:</span> @_gameround.ReferenceId</div>
                        <div class="history-dtl"><span class="lbl-header">Time:</span> @_gameround.DateCreatedTime</div>
                        <div class="history-dtl"><span class="lbl-header">Bet:</span> @_gameround.BetValue</div>
                        <div class="lbl-header">Amount: @_gameround.BetAmount</div>
                    </td>
                    <td class="col align-items-center justify-content-center d-flex">@_gameround.GameResult</td>
                    <td class="col justify-content-center d-flex align-items-center " style="font-size: 12px;">@(_gameround.Won ? Decimal.Parse(_gameround.WonAmount).ToString("N2") : "0.00")</td>
                        @if (_gameround.ConsoledAmount != "0.00")
                        {
                        <td class="ConsoStatus col align-items-center justify-content-center d-flex">@(Decimal.Parse(_gameround.ConsoledAmount).ToString("N2")) </td>
                        }
                        else if (_gameround.Cancelled || (!_gameround.Won && !_gameround.Lost && !_gameround.Cancelled))
                        {
                        <td class="col align-items-center justify-content-center d-flex">@Constants.BetReturned</td>
                        }
                        else if (_gameround.RoundStatus == (int)RoundStatus.PendingResult || _gameround.RoundStatus == (int)RoundStatus.Open)
                        {
                        <td class="ConsoStatus col align-items-center justify-content-center d-flex">@Constants.PendingBets </td>
                        }
                        else
                        {
                        <td class="col justify-content-center d-flex align-items-center  @(_gameround.IsProfit ? "WinStatus" : "LossStatus")" style="font-size: 12px; font-weight:600;">@(Decimal.Parse(_gameround.ProfitLoss).ToString("N2"))</td>
                        }
                </tr>
                }
                else
                {
                <tr class="beHistoryBg row  text-dark mr-0">
                    <td class="col-5 m-0 p-0">
                        <div class="lbl-header">@_gameround.GameTypeName</div>
                        <div class="history-dtl"><span class="lbl-header">Id:</span> @_gameround.ReferenceId</div>
                        <div class="history-dtl"><span class="lbl-header">Time:</span> @_gameround.DateCreatedTime</div>
                        <div class="lbl-header">Bet: @_gameround.BetAmount</div>
                    </td>
                    <td class="col p-0 justify-content-end d-flex align-items-center " style="font-size: 12px;">@(Decimal.Parse(_gameround.WonAmount).ToString("N2"))</td>
                    <td class="col p-0 justify-content-end d-flex align-items-center  @(_gameround.IsProfit ? "WinStatus" : "LossStatus")" style="font-size: 12px; font-weight:600;">@(Decimal.Parse(_gameround.ProfitLoss).ToString("N2"))</td>
                </tr>
                }
        </Virtualize>

            @if (_compBetHistoryViewModel.ShowSeeMoreButton)
            {
            <tr class="beHistoryBg row text-dark mr-0">
                <td colspan="3" class="text-center">
                        @if (!_compBetHistoryViewModel.ShowAllRows)
                        {
                        <a class="" @onclick:preventDefault @onclick='(() => ShowAll())'>Show More</a>
                        }
                        else
                        {
                        <a class="" @onclick:preventDefault @onclick='(() => ShowAll())'>Show Less</a>
                        }
                </td>
            </tr>
            }
        }
        else
        {
        <span>Loading </span>
        }
    </tbody>
</table>