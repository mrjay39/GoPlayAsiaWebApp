@using GoPlayAsiaWebApp.Goplay.Games.First3B.Components
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoplayasiaBlazor.Models.Constants
@using static GoplayasiaBlazor.Models.Constants.Settings
@inject First3BViewModel _f3BViewModel;
@inject IToastService _toastService;

<marquee class="text-light d-flex justify-content-center font-weight-bolder" style="font-size: 15px; padding: 2px 0; line-height: normal">WELCOME TO FIRST 3 TABLE 2 CARD GAME @_f3BViewModel.TickerMessage </marquee>
<div class="mainContainer row d-block" style="line-height: normal">
    <div class="col row1 p-0 d-flex text-light ">

        <MainBetSelection BetValueDisplay="@Settings.Constants.Gold"
                          ShowTotalBets="@_f3BViewModel.ShowTotalBets"
                          SampleWinFixedPrizeGold="@SampleWinFixedPrizeGold"
                          SampleWinFixedPrizeSilver="@SampleWinFixedPrizeSilver"
                          FixedPriceGoldMultiplier="@FixedPriceGoldMultiplier"
                          FixedPriceSilverMultipler="@FixedPriceSilverMultipler"
                          RoundStatusString="@RoundStatusString"
                          UserTotalBet_FixedPrizeGold="@_f3BViewModel.UserTotalBet_FixedPrizeGold"
                          ActiveButtonGold="@ActiveButtonGold"
                          WinnerResults="@_f3BViewModel.GameResultString"
                          IsDisabled="@_f3BViewModel.IsButtonDisabled"
                          OnClickCallback="@(() => SelectBetType((int)@Settings.F3MainBetTypes.Gold))" />

        <MainBetSelection BetValueDisplay="@Settings.Constants.Silver"
                          ShowTotalBets="@_f3BViewModel.ShowTotalBets"
                          SampleWinFixedPrizeGold="@SampleWinFixedPrizeGold"
                          SampleWinFixedPrizeSilver="@SampleWinFixedPrizeSilver"
                          FixedPriceGoldMultiplier="@FixedPriceGoldMultiplier"
                          FixedPriceSilverMultipler="@FixedPriceSilverMultipler"
                          RoundStatusString="@RoundStatusString"
                          UserTotalBet_FixedPrizeSilver="@_f3BViewModel.UserTotalBet_FixedPrizeSilver"
                          ActiveButtonSilver="@ActiveButtonSilver"
                          WinnerResults="@_f3BViewModel.GameResultString"
                          IsDisabled="@_f3BViewModel.IsButtonDisabled"
                          OnClickCallback="@(() => SelectBetType((int)@Settings.F3MainBetTypes.Silver))" /> 
    </div>

    <div class="row3 p-0 d-flex text-light">
        <SubSameSuites BetValueDisplay="@Settings.Constants.Gold"
                       SameSuiteGold="@SameSuiteGold"
                       UserTotalBet_SuitsGold="@_f3BViewModel.UserTotalBet_SuitsGold"
                       SampleWinSuitsGold="@_f3BViewModel.SampleWinSuitsGold"
                       WinnerResults="@_f3BViewModel.GameResult.LeftWinningSuits"
                       IsDisabled="@_f3BViewModel.IsButtonDisabled"
                       OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.SameSuiteGold))" />

        <SubTrio Trio="@Trio"
                 UserTotalBet_Trio="@_f3BViewModel.UserTotalBet_Trio"
                 SampleWinTrio="@_f3BViewModel.SampleWinTrio"
                 WinnerResults="@_f3BViewModel.GameResult.TrioResult"
                 IsDisabled="@_f3BViewModel.IsButtonDisabled"
                 OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.Trio))" />

        <SubSameSuites BetValueDisplay="@Settings.Constants.Silver"
                       SameSuiteSilver="@SameSuiteSilver"
                       UserTotalBet_SuitsSilver="@_f3BViewModel.UserTotalBet_SuitsSilver"
                       SampleWinSuitsSilver="@_f3BViewModel.SampleWinSuitsSilver"
                       WinnerResults="@_f3BViewModel.GameResult.RightWinningSuits"
                       IsDisabled="@_f3BViewModel.IsButtonDisabled"
                       OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.SameSuiteSilver))" />
    </div>

    <div class="row4 p-0 d-flex text-light maxWidth">

        <SubReds BetValueDisplay="@Settings.Constants.Gold"
                 TwoRedGold="@TwoRedGold"
                 UserTotalBet_ColorRedGold="@_f3BViewModel.UserTotalBet_ColorRedGold"
                 SampleWinColorRedGold="@_f3BViewModel.SampleWinColorRedGold"
                 WinnerResults="@_f3BViewModel.GameResult.LeftWinningColor"
                 IsDisabled="@_f3BViewModel.IsButtonDisabled"
                 OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.TwoRedGold))" />

        <SubBlacks BetValueDisplay="@Settings.Constants.Gold"
                   TwoBlackGold="@TwoBlackGold"
                   UserTotalBet_ColorBlackGold="@_f3BViewModel.UserTotalBet_ColorBlackGold"
                   SampleWinColorBlackGold="@_f3BViewModel.SampleWinColorBlackGold"
                   WinnerResults="@_f3BViewModel.GameResult.LeftWinningColor"
                   IsDisabled="@_f3BViewModel.IsButtonDisabled"
                   OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.TwoBlackGold))" />
        <SubReds BetValueDisplay="@Settings.Constants.Silver"
                 TwoRedSilver="@TwoRedSilver"
                 UserTotalBet_ColorRedSilver="@_f3BViewModel.UserTotalBet_ColorRedSilver"
                 SampleWinColorRedSilver="@_f3BViewModel.SampleWinColorRedSilver"
                 WinnerResults="@_f3BViewModel.GameResult.RightWinningColor"
                 IsDisabled="@_f3BViewModel.IsButtonDisabled"
                 OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.TwoRedSilver))" />

        <SubBlacks BetValueDisplay="@Settings.Constants.Silver"
                   TwoBlackSilver="@TwoBlackSilver"
                   UserTotalBet_ColorBlackSilver="@_f3BViewModel.UserTotalBet_ColorBlackSilver"
                   SampleWinColorBlackGold="@_f3BViewModel.SampleWinColorBlackSilver"
                   WinnerResults="@_f3BViewModel.GameResult.RightWinningColor"
                   IsDisabled="@_f3BViewModel.IsButtonDisabled"
                   OnClickCallback="@(() => SelectBetType((int)@Settings.F3SubBetTypes.TwoBlackSilver))" />
    </div>

    @if (_f3BViewModel.RoundStatusString == Settings.Constants.Open)
    {
        <div class="@_f3BViewModel.TokenDiv">
            <Tokens GameChips="@_f3BViewModel.GameChips" TokenContainer="@TokenContainer" OnClickCallback="@(() => CheckIfPlaceBetReady())" />
        </div>
    }
    else if (_f3BViewModel.RoundStatusString == Settings.Constants.Cancelled)
    {
        <div class="cancelledText text-center w-100">
            <p class="col p-0">CANCELLED GAME</p>
            <p class="col p-0">BETS RETURNED </p>
        </div>
    }
</div>

@code {
    [CascadingParameter] public IModalService popupModal { get; set; }
    [CascadingParameter] public IModalService popupModalDB { get; set; }
    [Parameter] public string RoundStatusString { get; set; } = String.Empty;
    [Parameter] public string SampleWinFixedPrizeGold { get; set; } = "0";
    [Parameter] public string SampleWinFixedPrizeSilver { get; set; } = "0";
    [Parameter] public string FixedPriceGoldMultiplier { get; set; } = String.Empty;
    [Parameter] public string FixedPriceSilverMultipler { get; set; } = String.Empty;

    public bool IsBetPopupShown = false;
    public string ActiveButtonGold { get; set; } = "goldButton";
    public string ActiveButtonSilver { get; set; } = "silverButton";
    public string Trio { get; set; } = "trioButton";
    public string SameSuiteGold { get; set; } = "sameSuitGold";
    public string SameSuiteSilver { get; set; } = "sameSuitSilver";
    public string TwoRedGold { get; set; } = "reds2Gold";
    public string TwoRedSilver { get; set; } = "reds2Silver";
    public string TwoBlackGold { get; set; } = "black2Gold";
    public string TwoBlackSilver { get; set; } = "black2Silver";
    public string TokenContainer { get; set; } = "DistokenContainer";

    public string ResetButtonCss { get; set; } = "disResetButton";
    public string BetButtonCss { get; set; } = "disBetButton";

    public async void OnNotify()
    {
        await InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        _f3BViewModel.Notify -= OnNotify;
    }

    protected override async Task OnInitializedAsync()
    {
        _f3BViewModel.Notify += OnNotify;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RoundStatusString != Constants.Open)
        {
            await DisableGameButtonsExceptCurrent();
        }
    }

    private async Task ResetGameButtons()
    {
        _f3BViewModel.IsButtonDisabled = !_f3BViewModel.IsButtonDisabled;

        ActiveButtonGold = "goldButton";
        ActiveButtonSilver = "silverButton";
        Trio = "trioButton";
        SameSuiteGold = "sameSuitGold";
        SameSuiteSilver = "sameSuitSilver";
        TwoRedGold = "reds2Gold";
        TwoRedSilver = "reds2Silver";
        TwoBlackGold = "black2Gold";
        TwoBlackSilver = "black2Silver";

        ResetButtonCss = "disResetButton";
        BetButtonCss = "disBetButton";
    }

    public async Task ResetToInitial()
    {
        await ResetGameButtons();
        TokenContainer = "DistokenContainer";
        _f3BViewModel.CurrentGameType = 0;
        _f3BViewModel.BetAmount = 0;
        _f3BViewModel.GameVariantId = 0;
        _f3BViewModel.BetOptionSelected = string.Empty;
        _f3BViewModel.BetCombinationValue = string.Empty;
    }

    public async Task DisableGameButtonsExceptCurrent()
    {
        if (_f3BViewModel.RoundStatusString != Constants.Open) _f3BViewModel.CurrentGameType = 0;
        if (_f3BViewModel.CurrentGameType != (int)F3MainBetTypes.Silver) ActiveButtonSilver = "DisSilverButton";
        if (_f3BViewModel.CurrentGameType != (int)F3MainBetTypes.Gold) ActiveButtonGold = "DisGoldButton";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.Trio) Trio = "disTrioButton";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.SameSuiteGold) SameSuiteGold = "disSameSuitGold";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.SameSuiteSilver) SameSuiteSilver = "disSameSuitSilver";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.TwoRedGold) TwoRedGold = "disReds2Gold";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.TwoRedSilver) TwoRedSilver = "disReds2Silver";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.TwoBlackGold) TwoBlackGold = "disBlack2Gold";
        if (_f3BViewModel.CurrentGameType != (int)F3SubBetTypes.TwoBlackSilver) TwoBlackSilver = "disBlack2Silver";
    }

    public async Task SelectBetType(int BetType)
    {
        await ResetGameButtons();
        TokenContainer = "tokenContainer";
        _f3BViewModel.CurrentGameType = BetType;
        _f3BViewModel.BetType = BetType;

        switch (BetType)
        {
            case (int)F3MainBetTypes.Gold:
                var isCrossBetting = _f3BViewModel.F3IsCrossBetting(Constants.FixedGold, _f3BViewModel.F3UserBets).Result;
                if (isCrossBetting)
                {
                    _toastService.ShowError("Cross betting not allowed!");
                    await ResetGameButtons();
                    return;
                }
                ActiveButtonGold = "goldButtonActive";
                await _f3BViewModel.SetGameChips(_f3BViewModel.GametypeId, false);
                _f3BViewModel.BetOptionSelected = Constants.Gold;
                _f3BViewModel.BetCombinationValue = Constants.FixedGold;
                _f3BViewModel.GameVariantId = 0;
                break;
            case (int)F3MainBetTypes.Silver:
                var isCrossBettingSilver = _f3BViewModel.F3IsCrossBetting(Constants.FixedSilver, _f3BViewModel.F3UserBets).Result;
                if (isCrossBettingSilver)
                {
                    _toastService.ShowError("Cross betting not allowed!");
                    await ResetGameButtons();
                    return;
                }
                ActiveButtonSilver = "silverButtonActive";
                await _f3BViewModel.SetGameChips(_f3BViewModel.GametypeId, false);
                _f3BViewModel.BetOptionSelected = Constants.Silver;
                _f3BViewModel.BetCombinationValue = Constants.FixedSilver;
                _f3BViewModel.GameVariantId = 0;
                break;
            case (int)F3SubBetTypes.Trio:
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BTrio, true);
                _f3BViewModel.BetOptionSelected = Constants.Trio;
                _f3BViewModel.BetCombinationValue = Constants.Trio;
                Trio = "trioButtonActivated";
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BTrio;
                break;
            case (int)F3SubBetTypes.SameSuiteGold:
                SameSuiteGold = "sameSuitGoldActivated";
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BSuits, true);
                _f3BViewModel.BetOptionSelected = Constants.Gold;
                _f3BViewModel.BetCombinationValue = Constants.SuitsGold;
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BSuits;
                break;
            case (int)F3SubBetTypes.SameSuiteSilver:
                SameSuiteSilver = "sameSuitSilverActivated";
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BSuits, true);
                _f3BViewModel.BetOptionSelected = Constants.Silver;
                _f3BViewModel.BetCombinationValue = Constants.SuitsSilver;
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BSuits;
                break;
            case (int)F3SubBetTypes.TwoRedGold:
                TwoRedGold = "reds2GoldActivated";
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BColor, true);
                _f3BViewModel.BetOptionSelected = Constants.Gold;
                _f3BViewModel.BetCombinationValue = Constants.ColorRedGold;
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BColor;
                break;
            case (int)F3SubBetTypes.TwoRedSilver:
                TwoRedSilver = "reds2SilverActivated";
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BColor, true);
                _f3BViewModel.BetOptionSelected = Constants.Silver;
                _f3BViewModel.BetCombinationValue = Constants.ColorRedSilver;
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BColor;
                break;
            case (int)F3SubBetTypes.TwoBlackGold:
                TwoBlackGold = "black2GoldActivated";
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BColor, true);
                _f3BViewModel.BetOptionSelected = Constants.Gold;
                _f3BViewModel.BetCombinationValue = Constants.ColorBlackGold;
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BColor;
                break;
            case (int)F3SubBetTypes.TwoBlackSilver:
                TwoBlackSilver = "black2SilverActivated";
                await _f3BViewModel.SetGameChips((int)GameVariant.F3BColor, true);
                _f3BViewModel.BetOptionSelected = Constants.Silver;
                _f3BViewModel.BetCombinationValue = Constants.ColorBlackSilver;
                _f3BViewModel.GameVariantId = (int)GameVariant.F3BColor;
                break;
            default:
                break;
        }

        await _f3BViewModel.ShowDivToken();
    }

    public async Task CheckIfPlaceBetReady()
    {
        if (_f3BViewModel.CurrentGameType != 0 && _f3BViewModel.BetAmount > 0)
        {
            ResetButtonCss = "resetButton";
            BetButtonCss = "betButton";
        }
        else
        {
            ResetButtonCss = "DisResetButton";
            BetButtonCss = "DisBetButton";
        }
    }

    public async Task ShowBetPopup(string betOptionSelected, string betCombinationValue)
    {
        if (IsBetPopupShown) return;

        _f3BViewModel.BetOptionSelected = betOptionSelected;
        _f3BViewModel.BetCombinationValue = betCombinationValue;

        bool iscrossbetting = await _f3BViewModel.IsCrossBetting(_f3BViewModel.BetCombinationValue, _f3BViewModel.UserBets);
        if (!iscrossbetting)
        {
            _f3BViewModel.popupBet = popupModal.Show<PopupConfirm>("Place Bet", new ModalOptions() { Class = "bet-modal" });
            IsBetPopupShown = true;
            ModalResult result = await _f3BViewModel.popupBet.Result;
            IsBetPopupShown = false;
        }
        else
        {
            _toastService.ShowError("Cross betting not allowed!");
        }
    }

    public async Task SubmitBet()
    {
        bool valid = await _f3BViewModel.ValidateBet(_f3BViewModel.BetOptionSelected, _f3BViewModel.BetCombinationValue);
        if (valid)
        {
            bool doublebet = await _f3BViewModel.IsDoubleBet();
            if (doublebet)
            {
                var parametersdb = new ModalParameters();
                parametersdb.Add("Message", "Already Placed Bet, Do you wish to proceed?");
                var popupDB = popupModalDB.Show<PopupConfirm>("", parametersdb, new ModalOptions() { Class = "op-modal" });
                ModalResult resultdb = await popupDB.Result;
                if ((bool)resultdb.Data)
                {
                    ResetButtonCss = "disResetButton";
                    BetButtonCss = "disBetButton";

                    await _f3BViewModel.SubmitBet();
                    ResetButtonCss = "ResetButton";
                    BetButtonCss = "BetButton";
                }
            }
            else
            {
                ResetButtonCss = "disResetButton";
                BetButtonCss = "disBetButton";

                await _f3BViewModel.SubmitBet();
                ResetButtonCss = "ResetButton";
                BetButtonCss = "BetButton";
            }
            await ResetToInitial();
        }
    }

}
