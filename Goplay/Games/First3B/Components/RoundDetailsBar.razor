<div class="MainContainer ">
    <div class="innerContainer d-flex justify-content-center">

        <div class="col borderGold d-flex justify-content-center align-items-center">
            <p><span class="gameText">G#:</span> <span class="gameNumber">@RoundNumber</span></p>
        </div>

         <button class="btn p-0 col-5 d-flex justify-content-center align-items-center ml-2 mr-2">
            <div class="d-flex mainTokenRelative justify-content-center col p-0">
                <div>
                    <img class="token" style="width: 90px; height: 27px;" src="/img/defaul-token-l9.png" />
                </div>
                <div class="betrangeAbsolute align-items-center">
                    <h6 class="d-flex justify-content-center align-items-center  mb-0 font-weight-bold" style="font-size: 13px; font-weight: bold;color: black; line-height: .7;">@(NumFormatter(MinChipDisplay)) - @(NumFormatter(MaxChipDisplay))</h6>
                </div>
            </div>
        </button>

        <div class="col p-0 borderGold d-flex align-items-center">
            <i class="col p-0 fa-solid fa-coins d-flex justify-content-end ml-1" style="color: gold;"></i>
            <p class="col p-0 userTotalBet d-flex justify-content-start ml-2 align-items-center text-light">@TotalBets</p>
        </div>
    </div>
</div>

@code {
    [Parameter] public int RoundNumber { get; set; }
    [Parameter] public int TotalBets { get; set; }
    [Parameter] public int MinChipDisplay { get; set; }
    [Parameter] public int MaxChipDisplay { get; set; }

    public static string NumFormatter(int param)
    {
        int amount = param;

        double value = Math.Truncate(10 * (amount / 1000D)) / 10;

        if (amount == 0 || amount < 10000)
        {
            return amount.ToString();
        }
        else if (amount % 100 == 0)
        {
            return value.ToString() + "K";
        }
        else
        {
            return value.ToString() + "K+";
        }
    }
}
