@using GoPlayAsiaWebApp.Goplay.Games.Shared
@using GoPlayAsiaWebApp.Goplay.Games.SharedCards
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoplayasiaBlazor.Models.Constants
@inject First3BViewModel _f3BViewModel;

@if (BetValueDisplay == Settings.Constants.Gold)
{
    @if (RoundStatusString == Settings.Constants.Open)
    {
        <button @onclick=OnClickCallback class="@(_f3BViewModel.IsFixedGoldEnabled == false ? "DisGoldButton" : ActiveButtonGold ) tieRelative borderGold btn col p-0 align-items-center" disabled="@IsDisabled">
            <div class="d-flex mt-1">
                <p class="font-weight-bold p-0 col d-flex justify-content-center mt-1 " style="font-size: 25px;">@BetValueDisplay</p>
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col pl-1 payout d-flex  justify-content-end font-weight-bold"> @SampleWinFixedPrizeGold</div>
                }
                else
                {
                    <p class="col pr-1 payout d-flex  justify-content-end font-weight-bold @(UserTotalBet_FixedPrizeGold != "0" ? "" : "") ">@FixedPriceGoldMultiplier</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizeGold" />
            @if (_f3BViewModel.Token_Animation != "" && _f3BViewModel.CurrentGameType == (int)Settings.F3MainBetTypes.Gold)
            {
                <div class="additionaltokencontainer" style="--animation: @_f3BViewModel.Token_Animation">
                    <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                    <p class="selectedAmountToken ">@_f3BViewModel.BetAmount</p>
                </div>
            }
        </button>
    }
    else
    {
        <div class="relativeDiv borderGold btn col p-0 @(Settings.Constants.Gold == WinnerResults ? "WinGoldButton" : (WinnerResults =="DRAW" ? "winnerTie" : "DisGoldButton"))">
            <div class="d-flex p-0 justify-content-center mt-1">
                <p class="font-weight-bold p-0 col d-flex justify-content-center" style="font-size: 20px;">@BetValueDisplay</p>
            </div>

            <div class="font-weight-bolder" style="font-size: 14px;line-height: normal;color: red !important; margin-top: -10px;">
                <span class="winnerText d-flex justify-content-center">@(Settings.Constants.Gold == WinnerResults ? "WINNER" : (WinnerResults == "DRAW" ? "" : ""))</span>
            </div>

            <div class="cardResultsGoldContainer justify-content-center align-items-center d-flex mt-1">
                @if (_f3BViewModel.GameResult.ValACard3 != String.Empty && _f3BViewModel.GameResult.ValACard3 != "NA" && _f3BViewModel.GameResult.ValACard3 is not null)
                {
                    <div class=" col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.GameResult.ValACard3" />
                    </div>
                }
                else if (_f3BViewModel.PreGameResult.ValACard3 != String.Empty && _f3BViewModel.PreGameResult.ValACard3 != "NA" && _f3BViewModel.PreGameResult.ValACard3 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.PreGameResult.ValACard3" />
                    </div>
                }
                else
                {
                    <NoCardSelected CardNumber="3" />
                }

                @if (_f3BViewModel.GameResult.ValACard2 != String.Empty && _f3BViewModel.GameResult.ValACard2 != "NA" && _f3BViewModel.GameResult.ValACard2 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.GameResult.ValACard2" />
                    </div>
                }
                else if (_f3BViewModel.PreGameResult.ValACard2 != String.Empty && _f3BViewModel.PreGameResult.ValACard2 != "NA" && _f3BViewModel.PreGameResult.ValACard2 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.PreGameResult.ValACard2" />
                    </div>
                }
                else
                {
                    <NoCardSelected CardNumber="2" />
                }

                @if (_f3BViewModel.GameResult.ValACard1 != String.Empty && _f3BViewModel.GameResult.ValACard1 != "NA" && _f3BViewModel.GameResult.ValACard1 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.GameResult.ValACard1" />
                    </div>
                }
                else if (_f3BViewModel.PreGameResult.ValACard1 != String.Empty && _f3BViewModel.PreGameResult.ValACard1 != "NA" && _f3BViewModel.PreGameResult.ValACard1 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.PreGameResult.ValACard1" />
                    </div>
                }
                else
                {
                    <NoCardSelected CardNumber="1" />
                }
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col pl-1 payout d-flex justify-content-end mt-2 font-weight-bold"> @SampleWinFixedPrizeGold</div>
                }
                else
                {
                    <p class="col pr-1 payout d-flex justify-content-end mt-2 font-weight-bold @(UserTotalBet_FixedPrizeGold != "0" ? "withBetF3" : "") ">@FixedPriceGoldMultiplier</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizeGold" />
        </div>
    }
}
else if (BetValueDisplay == Settings.Constants.Silver)
{
    @if (RoundStatusString == Settings.Constants.Open)
    {
        <button @onclick=OnClickCallback class="@(_f3BViewModel.IsFixedSilverEnabled == false ? "DisSilverButton" : ActiveButtonSilver ) tieRelative borderGold btn col p-0 justify-content-center align-items-center" disabled="@IsDisabled">
            <div class="d-flex  mt-1">
                <p class="font-weight-bold p-0 col d-flex justify-content-center mt-1  " style="font-size: 25px;">@BetValueDisplay</p>
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col pl-1 payout d-flex justify-content-end font-weight-bold">@SampleWinFixedPrizeSilver</div>
                }
                else
                {
                    <p class="col pr-1 payout d-flex justify-content-end font-weight-bold mt-1 @(UserTotalBet_FixedPrizeSilver != "0" ? "" : "")">@FixedPriceSilverMultipler</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizeSilver" />
            @if (_f3BViewModel.Token_Animation != "" && _f3BViewModel.CurrentGameType == (int)Settings.F3MainBetTypes.Silver)
            {
                <div class="additionaltokencontainerBanker" style="--animation: @_f3BViewModel.Token_Animation">
                    <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                    <p class="selectedAmountToken">@_f3BViewModel.BetAmount</p>
                </div>
            }
        </button>
    }
    else
    {
        <div class="relativeDiv borderGold btn col p-0 @(Settings.Constants.Silver == WinnerResults ?  "WinSilverButton" :  (WinnerResults =="DRAW" ?  "winnerTie" : "DisSilverButton")) ">
            <div class="d-flex p-0 justify-content-center mt-1">
                <p class="font-weight-bold p-0 col d-flex justify-content-center" style="font-size: 20px;">@BetValueDisplay</p>
            </div>

            <div class="font-weight-bolder" style="font-size: 14px;line-height: normal;color: red !important; margin-top: -10px;">
                <span class="winnerText d-flex justify-content-center">@(Settings.Constants.Silver == WinnerResults ? "WINNER" : (WinnerResults == "DRAW" ? "" : ""))</span>
            </div>

            <div class="cardResultsGoldContainer  justify-content-center align-items-center d-flex mt-1">
                @if (_f3BViewModel.GameResult.ValBCard1 != String.Empty && _f3BViewModel.GameResult.ValBCard1 != "NA" && _f3BViewModel.GameResult.ValBCard1 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.GameResult.ValBCard1" />
                    </div>
                }
                else if (_f3BViewModel.PreGameResult.ValBCard1 != String.Empty && _f3BViewModel.PreGameResult.ValBCard1 != "NA" && _f3BViewModel.PreGameResult.ValBCard1 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.PreGameResult.ValBCard1" />
                    </div>
                }
                else
                {
                    <NoCardSelected CardNumber="1" />
                }

                @if (_f3BViewModel.GameResult.ValBCard2 != String.Empty && _f3BViewModel.GameResult.ValBCard2 != "NA" && _f3BViewModel.GameResult.ValBCard2 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.GameResult.ValBCard2" />
                    </div>
                }
                else if (_f3BViewModel.PreGameResult.ValBCard2 != String.Empty && _f3BViewModel.PreGameResult.ValBCard2 != "NA" && _f3BViewModel.PreGameResult.ValBCard2 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.PreGameResult.ValBCard2" />
                    </div>
                }
                else
                {
                    <NoCardSelected CardNumber="2" />
                }

                @if (_f3BViewModel.GameResult.ValBCard3 != String.Empty && _f3BViewModel.GameResult.ValBCard3 != "NA" && _f3BViewModel.GameResult.ValBCard3 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.GameResult.ValBCard3" />
                    </div>
                }
                else if (_f3BViewModel.PreGameResult.ValBCard3 != String.Empty && _f3BViewModel.PreGameResult.ValBCard3 != "NA" && _f3BViewModel.PreGameResult.ValBCard3 is not null)
                {
                    <div class="col p-0 cardResultsVertical">
                        <MainCardViewer CardToShow="@_f3BViewModel.PreGameResult.ValBCard3" />
                    </div>
                }
                else
                {
                    <NoCardSelected CardNumber="3" />
                }
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col payout d-flex justify-content-end mr-1 p-0 mt-2 font-weight-bold"> @SampleWinFixedPrizeSilver</div>
                }
                else
                {
                    <p class="col payout d-flex justify-content-end mr-1 pr-0 mt-2 font-weight-bold @(UserTotalBet_FixedPrizeSilver != "0" ? "withBetF3" : "") ">@FixedPriceSilverMultipler</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizeSilver" />
        </div>
    }
}
@if (WinnerResults == "DRAW")
{
    <div class="tieResultText">TIE</div>
}

@code {
    [Parameter] public string BetValueDisplay { get; set; } = String.Empty;
    [Parameter] public bool ShowTotalBets { get; set; }
    [Parameter] public string RoundStatusString { get; set; } = String.Empty;
    [Parameter] public string ActiveButtonGold { get; set; } = "GoldButton";
    [Parameter] public string ActiveButtonSilver { get; set; } = "SilverButton";
    [Parameter] public string SampleWinFixedPrizeGold { get; set; } = "0";
    [Parameter] public string SampleWinFixedPrizeSilver { get; set; } = "0";
    [Parameter] public string UserTotalBet_FixedPrizeGold { get; set; } = "0";
    [Parameter] public string UserTotalBet_FixedPrizeSilver { get; set; } = "0";
    [Parameter] public string FixedPriceGoldMultiplier { get; set; } = String.Empty;
    [Parameter] public string FixedPriceSilverMultipler { get; set; } = String.Empty;
    [Parameter] public string WinnerResults { get; set; } = String.Empty;
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClickCallback { get; set; }
}
