    <div class=" col p-0 d-flex justify-content-center" style="background-color: #400000; padding: 6px;">
        <div class="col-3 p-0 text-light d-flex justify-content-center align-items-center" style="font-size: 12px;">
            <div class="" style="font-size: 12px;">
                <p>TAP BET TO</p>
                <p>CONFIRM ></p>
            </div>
        </div>

        <button class="w-100 d-flex justify-content-center mr-2 @(IsDisabled ? "disnewBetBtn" : "newBetBtn")" @onclick="(()=> SubmitBet())" disabled="@IsDisabled">
            <div> BET </div>
        </button>
        <button class="newBackBtn col-2 d-flex justify-content-center align-items-center" @onclick="(()=> CloseDiv())">
            <div>X</div>
        </button>
    </div>
