@using GoPlayAsiaWebApp.Goplay.ViewModels
@inject Lucky9BViewModel _l9BViewModel;

<div class="maincontainer">
    <div class="maincard container-fluid p-0">
        <div class="innerContainer row ">
            <p class="amo col-4 text-left pl-0">Amount</p>
            <p class="Min col text-right pr-0">Min: @String.Format("{0:#,##0}", _l9BViewModel.MinBet) - Max: @String.Format("{0:#,##0}", _l9BViewModel.MaxBet)</p>
            <input class="betAmo form-control font-weight-bolder" type="number" placeholder="@String.Format("{0:#,##0}",_l9BViewModel.BetAmount)" aria-label="default input example" disabled>

            <div class="tokenAmount container">
                <div class="tokenContainer">
                    <div class="upperToken row d-flex">
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip1))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip1Display</p>
                                <img src="/img/100.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip2))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip2Display</p>
                                <img src="/img/200.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip3))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip3Display</p>
                                <img src="/img/300.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip4))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip4Display</p>
                                <img src="/img/500.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip5))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip5Display</p>
                                <img src="/img/1k.png" />
                            </a>
                        </div>
                    </div>

                    <div class="lowerToken row d-flex">
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip6))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip6Display</p>
                                <img src="/img/1-5k.png" />
                            </a>
                        </div>
                         <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip7))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip7Display</p>
                                <img src="/img/2k.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip8))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip8Display</p>
                                <img src="/img/3k.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip9))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip9Display</p>
                                <img src="/img/5k.png" />
                            </a>
                        </div>
                        <div class="tokenValue col p-1 text-dark">
                            <a href="#" @onclick:preventDefault @onclick="@(()=> _l9BViewModel.SetBetSelectedValue(_l9BViewModel.GameChips.Chip10))">
                                <p class="Token">@_l9BViewModel.GameChips.Chip10Display</p>
                                <img src="/img/10k.png" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="lowerElemments mt-3 d-flex">
                <div class="select p-0 d-block">
                    <p class="mb-0">Select @_l9BViewModel.BetOptionSelected</p>
                    <p class="mb-0">Bet: <span>@String.Format("{0:#,##0}", _l9BViewModel.BetAmount)</span></p>
                </div>
                <div class="actionButtonBet d-flex row">
                    <button class="closeBtn" type="button" @onclick="Close">CLOSE</button>
                    <button class="betBtn" type="button" @onclick="@(async  ()=> await Confirmation())">PLACE BET</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [CascadingParameter] public IModalService popupModal { get; set; }
    [CascadingParameter] public IModalService popupModalDB { get; set; }
    public bool IsBetPopupShown = false;

    async Task Close() => await BlazoredModal.CloseAsync(ModalResult.Ok(true));
    async Task Cancel() => await BlazoredModal.CancelAsync();

    public async void OnNotify()
    {
        await InvokeAsync(() => StateHasChanged());
    }

    public void Dispose()
    {
        _l9BViewModel.Notify -= OnNotify;
    }

    public async Task Confirmation()
    {
        if (IsBetPopupShown) return;

        _l9BViewModel.popupModal = popupModal;
        bool valid = await _l9BViewModel.ValidateBet(_l9BViewModel.BetOptionSelected, _l9BViewModel.BetCombinationValue);
        if (valid)
        {
            var parameters = new ModalParameters();
            parameters.Add("Message", "Confirm bet " + _l9BViewModel.BetAmount + " for " + _l9BViewModel.BetCombinationValue);

            _l9BViewModel.popupConfirm = popupModal.Show<PopupConfirm>("", parameters, new ModalOptions() { Class = "op-modal" });
            IsBetPopupShown = true;
            ModalResult result = await _l9BViewModel.popupConfirm.Result;
            IsBetPopupShown = false;
            if (result.Data != null)
            {
                if ((bool)result.Data)
                {
                    if ((bool)result.Data)
                    {
                        bool doublebet = await _l9BViewModel.IsDoubleBet();
                        if (doublebet)
                        {
                            var parametersdb = new ModalParameters();
                            parametersdb.Add("Message", "Already Placed Bet, Do you wish to proceed?");
                            var popupDB = popupModalDB.Show<PopupConfirm>("", parametersdb, new ModalOptions() { Class = "op-modal" });
                            ModalResult resultdb = await popupDB.Result;
                            if ((bool)resultdb.Data)
                            {
                                await _l9BViewModel.SubmitBet();
                            }
                        }
                        else
                        {
                            await _l9BViewModel.SubmitBet();
                        }
                        _l9BViewModel.popupConfirm.Close();
                        _l9BViewModel.popupBet.Close();
                    }
                }
            }
        }
    }

}
