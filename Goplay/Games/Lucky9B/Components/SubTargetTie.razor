@using GoPlayAsiaWebApp.Goplay.Games.Shared
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoplayasiaBlazor.Models.Constants
@inject Lucky9BViewModel _l9BViewModel;

@if (BetType == (int)Settings.L9SubBetTypes.Target9Player)
{
    <button style="border-radius: 44%; height: 44px;" class="col btn p-0 borderGold tieRelative @(Settings.Constants.TargetPlayer == WinnerResults ? "winPLucky9" : TargetPlayer)" @onclick=OnClickCallback disabled="@IsDisabled">
        <p class="font-weight-bold smallHeader mb-1" style="font-size:10px; margin-top: 2px;">
            <span>LUCKY</span>
            <span style="font-size:15px">9</span>
        </p>

        <div class="d-flex">
            @if (_l9BViewModel.L9Target != null)
            {
                <p style="font-size: 13px;" class="payout font-weight-bold col p-0 d-flex justify-content-center mb-0 @(UserTotalBet_TargetPlayer != "0" ? "withBet" : "")">@(UserTotalBet_TargetPlayer != "0" ? SampleWinTargetPlayer : "x" + _l9BViewModel.L9Target.FixedPriceMultiplier.ToString("G29"))</p>
            }
        </div>

        <TokenDisplay Amount="@UserTotalBet_TargetPlayer" />
        @if (_l9BViewModel.Token_Animation != "" && _l9BViewModel.CurrentGameType == (int)Settings.L9SubBetTypes.Target9Player)
        {
            <div class="additionaltokencontainer" style="--animation: @_l9BViewModel.Token_Animation">
                <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                <p class="selectedAmountToken">@_l9BViewModel.BetAmount</p>
            </div>
        }
    </button>
}
@if (BetType == (int)Settings.L9MainBetTypes.Draw)
{
    <button style="border-radius: 50%; height: 93%;" class="bankerButton tieRelative borderGold btn col-2 p-0 justify-content-center align-items-center @(Settings.Constants.Draw == WinnerResults ? "winTieButton" : TargetTie)" @onclick=OnClickCallback disabled="@IsDisabled">
        <div class="d-flex mt-1 justify-content-center">
            <p class="font-weight-bold mb- mt-1 mb-2 font-weight-bold" style="font-size: 19px; letter-spacing: 2px;">TIE</p>
        </div>

        <div class="d-flex">
            @if (_l9BViewModel.L9Draw != null)
            {
                <p style="font-size: 15px;" class="payout font-weight-bold col p-0 d-flex justify-content-center mb-0 ">
                    @(UserTotalBet_Draw != "0" ? "" : "x" + _l9BViewModel.L9Draw.FixedPriceMultiplier.ToString("G29"))
                </p>
            }
        </div>

        <TokenDisplay Amount="@UserTotalBet_Draw" />
        @if (_l9BViewModel.Token_Animation != "" && _l9BViewModel.CurrentGameType == (int)Settings.L9MainBetTypes.Draw)
        {
            <div class="additionaltokencontainerTie" style="--animation: @_l9BViewModel.Token_Animation">
                <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                <p class="selectedAmountToken">@_l9BViewModel.BetAmount</p>
            </div>
        }
    </button>
}
@if (BetType == (int)Settings.L9SubBetTypes.Target9Banker)
{
    <button style="border-radius: 44%; height: 44px;" class="col btn p-0 borderGold tieRelative @(Settings.Constants.TargetBanker == WinnerResults ?  "winBLucky9" : TargetBanker)" @onclick=OnClickCallback disabled="@IsDisabled">
        <p class="font-weight-bold smallHeader mb-1" style="font-size:10px; margin-top: 2px;">
            <span>LUCKY</span>
            <span style="font-size:15px">9</span>
        </p>

        <div class="d-flex">
            @if (_l9BViewModel.L9Target != null)
            {
                <p style="font-size: 13px;" class="payout font-weight-bold col p-0 d-flex justify-content-center @(UserTotalBet_TargetBanker != "0" ? "withBet" : "") ">
                    @(UserTotalBet_TargetBanker != "0" ? SampleWinTargetBanker : "x" + _l9BViewModel.L9Target.FixedPriceMultiplier.ToString("G29"))
                </p>
            }
        </div>

        <TokenDisplay Amount="@UserTotalBet_TargetBanker" />
        @if (_l9BViewModel.Token_Animation != "" && _l9BViewModel.CurrentGameType == (int)Settings.L9SubBetTypes.Target9Banker)
        {
            <div class="additionaltokencontainerBanker" style="--animation: @_l9BViewModel.Token_Animation">
                <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                <p class="selectedAmountToken">@_l9BViewModel.BetAmount</p>
            </div>
        }
    </button>
}

@code {
    [Parameter] public int BetType { get; set; } = 0;
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string TargetPlayer { get; set; } = String.Empty;
    [Parameter] public string TargetBanker { get; set; } = String.Empty;
    [Parameter] public string TargetTie { get; set; } = String.Empty;
    [Parameter] public string UserTotalBet_TargetPlayer { get; set; } = String.Empty;
    [Parameter] public string UserTotalBet_TargetBanker { get; set; } = String.Empty;
    [Parameter] public string UserTotalBet_Draw { get; set; } = String.Empty;
    [Parameter] public string SampleWinTargetPlayer { get; set; } = String.Empty;
    [Parameter] public string SampleWinTargetBanker { get; set; } = String.Empty;
    [Parameter] public string WinnerResults { get; set; } = String.Empty;
    [Parameter] public EventCallback<MouseEventArgs> OnClickCallback { get; set; }
}
