@using GoPlayAsiaWebApp.Goplay.Games.Shared
@using GoPlayAsiaWebApp.Goplay.Games.SharedCards
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoplayasiaBlazor.Models.Constants
@inject Lucky9BViewModel _l9BViewModel;

@if (BetValueDisplay == Settings.Constants.Player)
{
    @if (RoundStatusString == Settings.Constants.Open)
    {
        <button @onclick=OnClickCallback class="@(_l9BViewModel.IsFixedPlayerEnabled == false ? "DisplayerButton" : ActiveButtonPlayer) tieRelative borderGold btn col p-0 align-items-center" disabled="@IsDisabled">
            <div class="d-flex mt-1">
                <p class="font-weight-bold p-0 col d-flex justify-content-center mt-1" style="font-size: 20px;">@BetValueDisplay</p>
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col pl-1 payout font-weight-bold d-flex mt-1 justify-content-end"> @SampleWinFixedPrizePlayer</div>
                }
                else
                {
                    <p style="font-size: 13px;" class="col pr-1 payout font-weight-bold d-flex mt-1 justify-content-end">195.00</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizePlayer" />
            @if (_l9BViewModel.Token_Animation != "" && _l9BViewModel.CurrentGameType == (int)Settings.L9MainBetTypes.Player)
            {
                <div class="additionaltokencontainer" style="--animation: @_l9BViewModel.Token_Animation">
                    <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                    <p class="selectedAmountToken">@_l9BViewModel.BetAmount</p>
                </div>
            }
        </button>
    }
    else
    {
        <div class="borderGold btn col p-0 @(Settings.Constants.Player == WinnerResults ? "WinplayerButton" : (WinnerResults == "DRAW" ? "winnerTie" : "DisplayerButton"))">
            <div class="d-flex p-0 justify-content-center">
                <p class="font-weight-bold p-0 col d-flex justify-content-center" style="font-size: 20px;">
                    <span>@BetValueDisplay</span>
                    <span class="win-msg">WINNER</span>
                </p>
                <p class="totalResultValue p-0 mvr-10 playerResult">@_l9BViewModel.PlayerCardValue</p>
            </div>

            <div class="mt-1">
                <div class="cardResultsPlayerContainer text-end align-items-center justify-content-center d-flex w-100 right-4">
                    @if (_l9BViewModel.GameResult.ValACard3 != String.Empty && _l9BViewModel.GameResult.ValACard3 != "NA" && _l9BViewModel.GameResult.ValACard3 is not null)
                    {
                        <div class="horizontalCard">
                            <MainCardViewer CardToShow="@_l9BViewModel.GameResult.ValACard3" />
                        </div>
                    }
                    else if (_l9BViewModel.PreGameResult.ValACard3 != String.Empty && _l9BViewModel.PreGameResult.ValACard3 != "NA" && _l9BViewModel.PreGameResult.ValACard3 is not null)
                    {
                        <div class="horizontalCard">
                            <MainCardViewer CardToShow="@_l9BViewModel.PreGameResult.ValACard3" />
                        </div>
                    }
                    else
                    {
                        <div class="horizontalCardBlank " style="background: none !important;">
                            <NoCardSelectedHorizontal CardNumber="3" />
                        </div>
                    }

                    @if (_l9BViewModel.GameResult.ValACard2 != String.Empty && _l9BViewModel.GameResult.ValACard2 != "NA" && _l9BViewModel.GameResult.ValACard2 is not null)
                    {
                        <div class="col cardResultsVertical playerCardCenter ml-2">
                            <MainCardViewer CardToShow="@_l9BViewModel.GameResult.ValACard2" />
                        </div>
                    }
                    else if (_l9BViewModel.PreGameResult.ValACard2 != String.Empty && _l9BViewModel.PreGameResult.ValACard2 != "NA" && _l9BViewModel.PreGameResult.ValACard2 is not null)
                    {
                        <div class="col cardResultsVertical ml-2">
                            <MainCardViewer CardToShow="@_l9BViewModel.PreGameResult.ValACard2" />
                        </div>
                    }
                    else
                    {
                        <NoCardSelected CardNumber="2" />
                    }

                    @if (_l9BViewModel.GameResult.ValACard1 != String.Empty && _l9BViewModel.GameResult.ValACard1 != "NA" && _l9BViewModel.GameResult.ValACard1 is not null)
                    {
                        <div class="col cardResultsVertical">
                            <MainCardViewer CardToShow="@_l9BViewModel.GameResult.ValACard1" />
                        </div>
                    }
                    else if (_l9BViewModel.PreGameResult.ValACard1 != String.Empty && _l9BViewModel.PreGameResult.ValACard1 != "NA" && _l9BViewModel.PreGameResult.ValACard1 is not null)
                    {
                        <div class="col cardResultsVertical">
                            <MainCardViewer CardToShow="@_l9BViewModel.PreGameResult.ValACard1" />
                        </div>
                    }
                    else
                    {
                        <NoCardSelected CardNumber="1" />
                    }
                </div>
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col pl-1 payout  font-weight-bold d-flex justify-content-end">@SampleWinFixedPrizePlayer</div>
                }
                else
                {
                    <p style="font-size: 13px;" class="col pr-1 payout font-weight-bold d-flex mt-1 justify-content-end">195.00</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizePlayer" />
        </div>
    }
}
else if (BetValueDisplay == Settings.Constants.Banker)
{
    @if (RoundStatusString == Settings.Constants.Open)
    {
        <button @onclick=OnClickCallback class="@(_l9BViewModel.IsFixedBankerEnabled == false ? "DisbankerButton" : ActiveButtonBanker ) tieRelative borderGold btn col p-0 justify-content-center align-items-center" disabled="@IsDisabled">
            <div class="d-flex mt-1">
                <p class="font-weight-bold p-0 col d-flex justify-content-center mt-1" style="font-size: 20px;">@BetValueDisplay</p>
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col pl-1 payout font-weight-bold d-flex mt-1 justify-content-end">@SampleWinFixedPrizeBanker</div>
                }
                else
                {
                    <p style="font-size: 13px;" class="col pr-1 payout font-weight-bold d-flex mt-1 justify-content-end">195.00</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizeBanker" />
            @if (_l9BViewModel.Token_Animation != "" && _l9BViewModel.CurrentGameType == (int)Settings.L9MainBetTypes.Banker)
            {
                <div class="additionaltokencontainerBanker" style="--animation: @_l9BViewModel.Token_Animation">
                    <img src="/img/selectedToken.png" class="tokenSelectedBet" />
                    <p class="selectedAmountToken">@_l9BViewModel.BetAmount</p>
                </div>
            }
        </button>
    }
    else
    {
        <div class="borderGold btn col p-0 tieRelative @(Settings.Constants.Banker == WinnerResults ? "WinbankerButton" : (WinnerResults =="DRAW" ?  "winnerTie" : "DisplayerButton"))">
            <div class="d-flex p-0 justify-content-center">
                <p class="font-weight-bold p-0 col justify-content-center" style="font-size: 20px;">
                    <span> @BetValueDisplay</span>
                    <span class="win-msg">WINNER</span>
                </p>
                <p class="totalResultValue p-0 mvr-10 bankerResult">@_l9BViewModel.BankerCardValue</p>
            </div>

            <div class="mt-1">
                <div class="cardResultsPlayerContainer text-start justify-content-center align-items-center d-flex w-100 left-0">
                    @if (_l9BViewModel.GameResult.ValBCard1 != String.Empty && _l9BViewModel.GameResult.ValBCard1 != "NA" && _l9BViewModel.GameResult.ValBCard1 is not null)
                    {
                        <div class="col cardResultsVertical">
                            <MainCardViewer CardToShow="@_l9BViewModel.GameResult.ValBCard1" />
                        </div>
                    }
                    else if (_l9BViewModel.PreGameResult.ValBCard1 != String.Empty && _l9BViewModel.PreGameResult.ValBCard1 != "NA" && _l9BViewModel.PreGameResult.ValBCard1 is not null)
                    {
                        <div class="col cardResultsVertical">
                            <MainCardViewer CardToShow="@_l9BViewModel.PreGameResult.ValBCard1" />
                        </div>
                    }
                    else
                    {
                        <NoCardSelected CardNumber="1" />
                    }

                    @if (_l9BViewModel.GameResult.ValBCard2 != String.Empty && _l9BViewModel.GameResult.ValBCard2 != "NA" && _l9BViewModel.GameResult.ValBCard2 is not null)
                    {
                        <div class="col cardResultsVertical bankerCardCenter mr-2">
                            <MainCardViewer CardToShow="@_l9BViewModel.GameResult.ValBCard2" />
                        </div>
                    }
                    else if (_l9BViewModel.PreGameResult.ValBCard2 != String.Empty && _l9BViewModel.PreGameResult.ValBCard2 != "NA" && _l9BViewModel.PreGameResult.ValBCard2 is not null)
                    {
                        <div class="col cardResultsVertical mr-2">
                            <MainCardViewer CardToShow="@_l9BViewModel.PreGameResult.ValBCard2" />
                        </div>
                    }
                    else
                    {
                        <NoCardSelected CardNumber="2" />
                    }

                    @if (_l9BViewModel.GameResult.ValBCard3 != String.Empty && _l9BViewModel.GameResult.ValBCard3 != "NA" && _l9BViewModel.GameResult.ValBCard3 is not null)
                    {
                        <div class=" horizontalCardBanker">
                            <MainCardViewer CardToShow="@_l9BViewModel.GameResult.ValBCard3" />
                        </div>
                    }
                    else if (_l9BViewModel.PreGameResult.ValBCard3 != String.Empty && _l9BViewModel.PreGameResult.ValBCard3 != "NA" && _l9BViewModel.PreGameResult.ValBCard3 is not null)
                    {
                        <div class="  horizontalCardBanker">
                            <MainCardViewer CardToShow="@_l9BViewModel.PreGameResult.ValBCard3" />
                        </div>
                    }
                    else
                    {
                        <div class="horizontalCardBlankBanker  mt-2" style="background: none !important;">

                            <NoCardSelectedHorizontal CardNumber="3" />
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex">
                @if (ShowTotalBets)
                {
                    <div class="col p-0 payout font-weight-bold d-flex justify-content-end"> @SampleWinFixedPrizeBanker</div>
                }
                else
                {
                    <p style="font-size: 13px;" class="col pr-1 payout font-weight-bold d-flex mt-1 justify-content-end">195.00</p>
                }
            </div>

            <TokenDisplay Amount="@UserTotalBet_FixedPrizeBanker" />
        </div>
    }
}

@code {
    [Parameter] public string BetValueDisplay { get; set; } = String.Empty;
    [Parameter] public string RoundStatusString { get; set; } = String.Empty;
    [Parameter] public bool ShowTotalBets { get; set; }
    [Parameter] public bool IsDisabled { get; set; }
    [Parameter] public string ActiveButtonPlayer { get; set; } = "playerButton";
    [Parameter] public string ActiveButtonBanker { get; set; } = "bankerButton";
    [Parameter] public string SampleWinFixedPrizePlayer { get; set; } = "0";
    [Parameter] public string SampleWinFixedPrizeBanker { get; set; } = "0";
    [Parameter] public string UserTotalBet_FixedPrizePlayer { get; set; } = "0";
    [Parameter] public string UserTotalBet_FixedPrizeBanker { get; set; } = "0";
    [Parameter] public string WinnerResults { get; set; } = String.Empty;
    [Parameter] public EventCallback<MouseEventArgs> OnClickCallback { get; set; }
}
