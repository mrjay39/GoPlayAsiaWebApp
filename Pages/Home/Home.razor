@page "/"
@page "/home"
@using GoPlayAsiaWebApp.Controls.FeaturedGames
@using GoPlayAsiaWebApp.Controls.GameLinkHeader
@using GoPlayAsiaWebApp.Controls.GameProviderSelectors
@using GoPlayAsiaWebApp.Controls.GameRegulation
@using GoPlayAsiaWebApp.Controls.HeaderAndFooter
@using GoPlayAsiaWebApp.Controls.Modal
@using GoPlayAsiaWebApp.Controls.HomeGames
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.GamesList
@using GoPlayAsiaWebApp.Pages.GPAGames.WelcomGPA
@inject LobbyViewModel lobbyViewModel
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable;


<PageTitle>GoPlayAsia: Home</PageTitle>

<div class="container-fluid marketing">

    <div id="hp-8" class="container-fluid">

        <HomeGames />
        <div data-aos="fade-up" data-aos-anchor-placement="center-bottom">
            <WelcomeGPA />
        </div>
        

    </div>
    @* <GameRegulation /> *@
    <div data-aos="fade-up" data-aos-anchor-placement="center-bottom" data-aos-duration="1000">
        <GameRegulation />
    </div>
    
    <AuthorizeView>
        <NotAuthorized>
            @if (showAgeAgreement)
            {
                <AgeAgreement OnAgree="HandleAgeAgreement" />
            }
        </NotAuthorized>
    </AuthorizeView>

    <GuesBottomNavbar _hrefLiveGameStr="GameProviders/More/live/All"
                      _hrefArcadeGameStr="GameProviders/More/rng/All"
                      _hrefSlotGameStr="GameProviders/More/slots/All"
                      _hrefCasinoGameStr="GameProviders/More/casino/All" />



</div>

@code {
    [Inject]
    public IJSRuntime JSRuntime { get; set; }
    [CascadingParameter] public IModalService popHowToInstall { get; set; }

    public void Dispose()
    {
        lobbyViewModel.Notify -= OnNotify;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
    private bool showAgeAgreement = true;



    protected override async Task OnInitializedAsync()
    {
        lobbyViewModel.Notify += OnNotify;
        var agreedItem = await JSRuntime.InvokeAsync<string>("sessionStorage.getItem", "agreedToTerms");
        bool agreed = !string.IsNullOrEmpty(agreedItem) && bool.Parse(agreedItem);
        if (agreed)
        {
            showAgeAgreement = false;
        }
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;

        if (user.Identity.IsAuthenticated)
        {
            bool isInstalled = await JSRuntime.InvokeAsync<bool>("isAppInstalled");
            var showInstall = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "showInstall");

            bool shouldShowInstall = string.IsNullOrEmpty(showInstall) || showInstall != "true";

            if (!isInstalled && shouldShowInstall)
            {
                var refPopup = popHowToInstall.Show<GetMobileApp>("", new ModalParameters(), new ModalOptions()
                    {
                        DisableBackgroundCancel = false,
                        HideCloseButton = false
                    });

                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "showInstall", "true");
            }
        }

        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            lobbyViewModel.ConnectSignalR();

        }

    }

    private async Task HandleAgeAgreement()
    {
        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "agreedToTerms", true);
        showAgeAgreement = false;
        StateHasChanged();
    }
    public async void OnNotify()
    {
        await InvokeAsync(() => StateHasChanged());
    }
}
