@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@if (hasContents)
{
    <div id="@_idStr" class="container">
        <h2 class="text-white fw-bold mt-2">@_title</h2>
        <h5 class="text-muted">@_description</h5>
        <div class="pb-4">
            <div class="row justify-content-center p-2">
                @if (GameList != null)
                {
                    if (_provider == "All")
                    {

                        @foreach (var item in GameList.Where(a => a.Category == _filter))
                        {
                            <GamesListTile Game="item" />
                        }
                    }
                    else
                    {
                        @foreach (var item in GameList.Where(a => a.Category == _filter && a.Provider == _provider))
                        {
                            <GamesListTile Game="item" />
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string _title { get; set; }
    [Parameter] public string _description { get; set; }
    [Parameter] public string _filter { get; set; }
    [Parameter] public string _provider { get; set; }
    [Parameter] public string _idStr { get; set; }
    private bool hasContents { get; set; } = false;
    [CascadingParameter] public List<eGamesListDTO> GameList { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        hasContents = false;
        if (_provider == "All")
        {
            if (GameList.Where(a => a.Category == _filter).Any())
            {
                hasContents = true;
            }
        }
        else
        {
            if (GameList.Where(a => a.Category == _filter && a.Provider == _provider).Any())
            {
                hasContents = true;
            }
        }
        base.OnParametersSetAsync();
    }

}