@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
<style>
    /* For Chrome, Safari, and Edge */
    ::-webkit-scrollbar {
        width: 8px; /* Width of the scrollbar */
        height: 8px; /* Height of the scrollbar for horizontal scroll */
    }

    ::-webkit-scrollbar-thumb {
        background-color: #888; /* Color of the scrollbar thumb */
        border-radius: 10px; /* Roundness of the scrollbar thumb */
    }

        ::-webkit-scrollbar-thumb:hover {
            background-color: #555; /* Darker color on hover */
        }

    ::-webkit-scrollbar-track {
        background: #f1f1f1; /* Color of the scrollbar track */
        border-radius: 10px; /* Roundness of the scrollbar track */
    }

</style>
@if (hasContents)
{
    <div id="@_idStr" class="container">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-12 p-0">
                    <div class="d-flex align-items-center mt-4">
                        <div class="col">
                            <h2 class="text-white fw-bold mt-1 text-start">@_title</h2>
                        </div>
                        <div class="col text-end">
                            <a class="btn border-0 p-0 bg-transparent fw-bold">
                                <h5 class="mb-0">
                                    <a href="/GameProviders/More/@_filter/@_provider" class="text-decoration-none text-muted p-0">
                                  See All
                                    </a>
                                </h5>
                            </a>
                        </div>
                    </div>
           @*          <h5 class="text-muted text-start">@_description</h5> *@
                </div>
            </div>
        </div>
        <div class="pb-4 gameOverflow-x">
            <div class="d-flex justify-content-center p-0">
                @if (GameList != null)
                {
                    var firstItem = _provider == "All"
                    ? GameList.Where(a => a.Category == _filter).FirstOrDefault()
                    : GameList.Where(a => a.Category == _filter && a.Provider == _provider).FirstOrDefault();

                    if (firstItem != null)
                    {
                        <GamesListTile 
                            isFirstItem="Large" 
                            Game="firstItem" />
                    }
                }
                @if (GameList != null)
                {
                    if (_provider == "All")
                    {

                        @foreach (var item in GameList.Where(a => a.Category == _filter).Take(10))
                        {
                            <GamesListTile Game="item" />
                        }
                    }
                    else
                    {
                        @foreach (var item in GameList.Where(a => a.Category == _filter && a.Provider == _provider).Take(10))
                        {
                            <GamesListTile Game="item" />
                        }
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string _title { get; set; }
    [Parameter] public string _description { get; set; }
    [Parameter] public string _filter { get; set; }
    [Parameter] public string _provider { get; set; }
    [Parameter] public string _idStr { get; set; }
    private bool hasContents { get; set; } = false;
    [CascadingParameter] public List<eGamesListDTO> GameList { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        hasContents = false;
        if (_provider == "All")
        {
            if (GameList.Where(a => a.Category == _filter).Any())
            {
                hasContents = true;
            }
        }
        else
        {
            if (GameList.Where(a => a.Category == _filter && a.Provider == _provider).Any())
            {
                hasContents = true;
            }
        }
        base.OnParametersSetAsync();
    }

}