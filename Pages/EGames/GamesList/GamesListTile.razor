@using System.Security.Claims
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager _navigationManager
@inject LobbyViewModel lobbyViewModel
@using GoPlayAsiaWebApp.Goplay.Shared.Popup
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.Login.LogInModal
@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaBlazor.Models.Constants
@using GoplayasiaSharedKernel.DTOs.eGames.Enum
@using System.Globalization;
@inject IJSRuntime JSRuntime

@if (Game.Provider != "Pragmatic")
{
    <a class="img-border card m-1 p-0 game-tileEvo text-decoration-none position-relative @(@isFirstItem== "Large" ? "Large" : "")" @onclick="OpenGameLink">
        <div class="">
            <div class=" p-0 bg-img">
                <img id="cardImage" src="@Game.Filename" class="card-img-top " @onclick="ToggleActive">
            </div>
        </div>
        <div @ref="imageElement" id="desc" class="position-absolute bottom-0 start-0 text-light  p-2 bg-dark bg-opacity-75  w-100 ">
            <small>@Game.Description</small>
            <small>@CultureInfo.CurrentCulture.TextInfo.ToTitleCase(@Game.Provider.ToLower())</small>
           
        </div>
    </a>
}

else
{
    <a class="img-border card m-1 p-0 game-tile text-decoration-none position-relative" @onclick="OpenGameLink">
        <div class="">
            <div class=" p-0 bg-img">
                <img id="cardImage" src="@Game.Filename" class="card-img-top @(@isFirstItem== "Large" ? "Large" : "")" @onclick="ToggleActive">
            </div>
        </div>
        <div @ref="imageElement" id="desc" class="position-absolute bottom-0 start-0 text-light  p-2 bg-dark bg-opacity-75  w-100 ">
            <small>@Game.Description</small>
            <small>@Game.Provider</small>
        </div>
    </a>
}
@code {
    [Parameter] public string? isFirstItem { get; set; } = string.Empty;
    [Parameter] public string? _gameInfoHrefStr { get; set; }
    [CascadingParameter] public IModalService popupModal { get; set; }
    [Parameter] public eGamesListDTO Game { get; set; }
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;
    [CascadingParameter] public IModalService popuLoadingpModal { get; set; }
    private ElementReference imageElement;
    IModalReference popupRef;
    private ClaimsPrincipal user;
    private bool isActive = false;
    private bool isCanvasVisible = false;
    private string gameImageUrl;
    private string gameCategory;
    private static bool IsLoading { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", "backURL", _navigationManager.Uri);

    }

    [JSInvokable("OnImageLoaded")]
    public static void OnImageLoaded()
    {
        IsLoading = false;

    }
    private void ToggleActive()
    {
        isActive = !isActive;
        if (isActive)
        {
            TimerCallback timerCallback = state =>
            {
                isActive = false;
                StateHasChanged(); 
            };
            var timer = new Timer(timerCallback, null, 4000, Timeout.Infinite);
        }
    }

    private async void OpenGameLink()
    {

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authenticationState.User;
            if (!user.Identity.IsAuthenticated)
            {
                if (Game.Category == Settings.Constants.egamesLive)
                {
                    popuLoadingpModal.Show<LoginAndSignUp>("", new ModalParameters(), new ModalOptions() { DisableBackgroundCancel = true, HideCloseButton = true });
                    return;
                }

                gameImageUrl = Game.Filename;
                var parameters = new ModalParameters
                {
                    { "IsVisible", true },
                    { "ImageUrl", gameImageUrl },
                    { "Category", Game.Category }

                };
                var modal = popuLoadingpModal.Show<PlayOffCanvas>("PlayOffCanvas", parameters);
                if (modal != null)
                {
                    var result = await modal.Result;
                    if (!result.Cancelled)
                    {
                        if (result.Data == "signUp")
                        {
                            popuLoadingpModal.Show<LoginAndSignUp>("", new ModalParameters(), new ModalOptions() { DisableBackgroundCancel = true, HideCloseButton = true });
                        }
                        else
                        {
                            Game.Mode = result.Data.ToString();
                            popupRef = popupModal.Show<PopupLoading>("");
                            await lobbyViewModel.LaunchGameMode(Game, result.Data.ToString());
                            _navigationManager.NavigateTo("playdemo");
                        }
                    }
                }
            }
            else
            {
                if (Game.Category == Settings.Constants.egamesLive)
                {
                    if (Game.Provider == Settings.Constants.GoPlayAsia)
                    {
                        switch (Game.GameId)
                        {
                            case (Settings.Constants.L9Game):
                                _navigationManager.NavigateTo("games/lucky9");
                            break;

                            case (Settings.Constants.F3Game):
                                _navigationManager.NavigateTo("games/first3");
                            break;

                            case (Settings.Constants.HTGame):
                                _navigationManager.NavigateTo("games/headstails");
                            break;

                            case (Settings.Constants.G12Game):
                                _navigationManager.NavigateTo("games/go12");
                            break;

                        }
                        return;

                    }
                    LaunchGame();
                }
                else
                {
                    gameImageUrl = Game.Filename;
                    var parameters = new ModalParameters
                     {
                            { "IsVisible", true },
                            { "ImageUrl", gameImageUrl },
                             { "Category", Game.Category }
                     };
                    var modal = popuLoadingpModal.Show<PlayOffCanvas>("PlayOffCanvas", parameters);
                    if (modal != null)
                    {
                        var result = await modal.Result;
                        if (!result.Cancelled)
                        {
                            Game.Mode = result.Data.ToString();
                            
                            LaunchGame();
                        }
                    }
                }

            }
        }
        catch (Exception)
        {
        }
    }
    private async void LaunchGame()
    {
      
        popupRef = popupModal.Show<PopupLoading>("");
        await lobbyViewModel.LaunchGame(Game);
        _navigationManager.NavigateTo("play");
    }
}