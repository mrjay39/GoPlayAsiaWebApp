@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.eGames.Enum
@using GoplayasiaBlazor.Models.Constants
<div id="playOffCanvas" data-bs-scroll="true" class="offcanvas offcanvas-bottom bg-light @(IsVisible ? "show" : "")" tabindex="-1" aria-labelledby="offcanvasBottomLabel">
    <AuthorizeView>
        <Authorized>
            @*===========  Buttons after Login ===========*@
            <div class="container d-flex align-items-center h-100">
                <div class="offcanvas-body small" style="z-index:1">
                    @if (Category != Settings.Constants.egamesLive)
                    {
                        <div class="d-block text-center p-2">
                            <button class="btn live-play-btn border-0" @onclick="(() => SelectMode(GameMode.real_money.ToString()))">
                                <img src="./img/play-btn.png" class="img img-fluid">
                            </button>
                        </div>
                    }
                    <div class="d-block text-center p-2">
                        @if (Category != Settings.Constants.egamesLive)
                        {
                            <button class="btn demo-play-btn border-0 ms-2" @onclick="(() => SelectMode(GameMode.play_for_fun.ToString()))">
                                <img src="./img/funPlay.png" class="img img-fluid">
                            </button>
                        }
                    </div>
                </div>
                <div class="bg-image" style="background-image: url('@ImageUrl')"></div>
            </div>
        </Authorized>
        <NotAuthorized>
            @*===========  Buttons Before Login ===========*@
            <div class="container d-flex align-items-center h-100">
                <div class="container text-center">
                    @if (Category != Settings.Constants.egamesLive)
                    {
                        <h4 class="text-center pt-3">
                            <b>Playing for fun</b>
                        </h4>
                        <p class="font-12 mb-2">This is a play for fun version of the game. Winnings cannot be cashed out. Login to play for real money.</p>
                    }
                    <div class="container">
                        <div class="col">
                            @if (Category != Settings.Constants.egamesLive)
                            {
                                @* <button type="button" class="btnPlayForFun btn btn-warning mr-2" @onclick="(() => SelectMode(GameMode.demo.ToString()))">Play For Fun</button> *@
                                <button class="btn demo-play-btn border-0 p-0" @onclick="(() => SelectMode(GameMode.demo.ToString()))">
                                    <img src="./img/demo-play.png" class="img img-fluid">
                                </button>
                            }
                        </div>
                        <div class="col m-2">
                            <button class="btn signup-btn border-0" @onclick="SignUp">
                                <img src="./img/sign-up.png" class="img img-fluid">
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>



@code {
    [Parameter] public string _title { get; set; }
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string ImageUrl { get; set; }
    [Parameter] public string playmode { get; set; }
    [Parameter] public string Category { get; set; }
    [CascadingParameter] BlazoredModalInstance BlazoredModal { get; set; } = default!;

    private async Task SelectMode(string playmode)
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok(playmode));
    }

    private async Task SignUp()
    {
        await BlazoredModal.CloseAsync(ModalResult.Ok("signUp"));
    }

}