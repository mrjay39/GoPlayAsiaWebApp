@using GoplayasiaBlazor.DTOs.eGames
@using GoplayasiaSharedKernel.DTOs.DTOIn
@using static GoplayasiaBlazor.Models.Constants.Settings
@if (hasContents)
{
    <div id="@_idStr" class="container">
        <h2 class="text-white fw-bold mt-2">@_title</h2>
        <h5 class="text-muted">@_description</h5>
        <div class="pb-4">
            <div class="row justify-content-center p-2">
                @if (GameList != null)
                {
                    if (_provider == "All")
                    {
                        <Virtualize Items="@GameList.Where(a => a.Category == _filter).ToList()" Context="item" ItemSize="@GameList.Where(a => a.Category == _filter).ToList().Count" OverscanCount="50" >
                            <GamesListTile Game="item" />
                        </Virtualize>

                      @*   @foreach (var item in GameList.Where(a => a.Category == _filter))
                        {
                            <GamesListTile Game="item" />
                        } *@
                    }
                    else
                    {
                        <Virtualize Items="@GameList.Where(a => a.Category == _filter && a.Provider == _provider).ToList()" Context="item" ItemSize="@GameList.Where(a => a.Category == _filter && a.Provider == _provider).ToList().Count" OverscanCount="50" >
                            <GamesListTile Game="item" />
                        </Virtualize>
                       @*  @foreach (var item in GameList.Where(a => a.Category == _filter && a.Provider == _provider))
                        {
                            <GamesListTile Game="item" />
                        } *@
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    public string _title { get; set; }
    public string _description { get; set; }
    public string _idStr { get; set; }

    [Parameter] public string _filter { get; set; }
    [Parameter] public string _provider { get; set; }
    private bool hasContents { get; set; } = false;
    [CascadingParameter] public List<eGamesListDTO> GameList { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        hasContents = false;
        if (_provider == "All")
        {
            if (GameList.Where(a => a.Category == _filter).Any())
            {
                hasContents = true;
            }
        }
        else
        {
            if (GameList.Where(a => a.Category == _filter && a.Provider == _provider).Any())
            {
                hasContents = true;
            }
        }   

        switch (_filter)
        {
            case Constants.egamesSlots :
                _title = Constants.SlotsGameTitle;
                _description = Constants.SlotsGameDescription;
                _idStr = "slotGame";
                break;
            case Constants.egamesLive:
                _title = Constants.CasinoGameTitle;
                _description = Constants.CasinoGameDescription;
                _idStr = "liveGame";
                break;
            case Constants.egamesRng:
                _title = Constants.ArcadeGameTitle;
                _description = Constants.ArcadeDescription;
                _idStr = "arcadeGame";
                break;
            case Constants.egamesCasino:
                _title = Constants.CasinoGameTitle;
                _description = Constants.CasinoGameDescription;
                _idStr = "cardGame";
                break;
            case Constants.egamesFishing:
                _title = Constants.FishingGameTitle;
                _description = Constants.FishingDescription;
                _idStr = "fishingGame";
                break;
        }
        

        base.OnParametersSetAsync();
    }

}