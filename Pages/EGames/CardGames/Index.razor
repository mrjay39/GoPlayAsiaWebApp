@page "/cardGames"
@using GoPlayAsiaWebApp.Controls.Carousel.CardCarousel
@using GoPlayAsiaWebApp.Controls.GameLinkHeader
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames.FishingGames
@using GoPlayAsiaWebApp.Pages.EGames.CardGames.Evolution
@using GoPlayAsiaWebApp.Pages.EGames.GamesList
@using GoPlayAsiaWebApp.Pages.EGames.LiveCasino
@using GoPlayAsiaWebApp.Pages.GPAGames
@using static GoplayasiaBlazor.Models.Constants.Settings
@inject LobbyViewModel lobbyViewModel

<PageTitle>GoPlayAsia: Card Games </PageTitle>

<div id="cardGames" class="container-fluid p-0 marketing">
    <CardCarousel />

    <GameLinkHeader />

    <div class="container">
        <h2 class="text-white fw-bold mt-5">Live and Exciting Games!</h2>
        <h5 class="text-muted">Real-Time Fun: Dive into Live Gaming Today!</h5>
        <div id="gpa-overflow" class="gameOverflow-x">
            <div class="justify-content-center">
                <GPATile _imgStr="./img/GPAGames/L9.png"
                         _idStr="lucky9"
                         _titleStr="Lucky 9"
                         _gameInfoHrefStr="/Lucky9Table" />

                <GPATile _imgStr="./img/GPAGames/HT.png"
                         _idStr="headsAndTails"
                         _titleStr="Heads and Tails"
                         _gameInfoHrefStr="games/headstails" />

                <GPATile _imgStr="./img/GPAGames/F3.png"
                         _idStr="first3"
                         _titleStr="First 3"
                         _gameInfoHrefStr="/First3Table" />

                <GPATile _imgStr="./img/GPAGames/G12.png"
                         _idStr="go12"
                         _titleStr="Go 12"
                         _gameInfoHrefStr="games/go12" />

                @* <GPATile _imgStr="./img/GPAGames/L4.png"
                _idStr="lucky4"
                _titleStr="Lucky 4"
                _gameInfoHrefStr="games/lucky4" /> *@

                @* <GPATile _imgStr="./img/GPAGames/BW.png"
                _idStr="bigWin"
                _titleStr="Big Win"
                _gameInfoHrefStr="games/bigwin" /> *@

                @*  <GPATile _imgStr="./img/GPAGames/new-dice.png"
                _idStr="diceGame"
                _titleStr="Dice" />

                <GPATile _imgStr="./img/GPAGames/hooray.png"
                _idStr="hooray"
                _titleStr="Hooray!" /> *@
            </div>
        </div>
    </div>

    <MostPLayedGameEvolution />

    <EvolutionCardGame />

    <div class="container">
        <h2 class="text-white fw-bold mt-5">Live Casino</h2>
        <h5 class="text-muted">Your Seat Awaits: Dive into Live Casino Bliss</h5>
        <div class="pb-2 gameOverflow-x">
            <div class="justify-content-center">
                @foreach (var item in lobbyViewModel.AllGameList.Where(a => a.Category == Constants.egamesLive))
                {
                    <GamesListTile _imgStr="@item.Filename"
                                   _titleStr="@item.Description"
                                   _gameId="@item.GameId"
                                   _provider="@item.Provider"
                                   _code="@item.Code" />
                }
            </div>
        </div>
    </div>

    <div class="container pb-4">
        <h2 class="text-white fw-bold mt-5">Fun and Exciting Games</h2>
        <h5 class="text-muted">Discover fun in our Fishing Games!</h5>
        <div class="pb-2 gameOverflow-x">
            <div class="justify-content-center">
               @*   @foreach (var item in lobbyViewModel.AllGameList.Where(a => a.GameVertical == Constants.egamesLive))
                {
                    <GamesListTile _imgStr="@item.FileName"
                                 _titleStr="@item.TableName" />
                } *@

                <FishingTile _imgStr="./img/fishing/JackpotFishing.png"
                             _titleStr="Jackpot Fishing"
                             _tryoutsHrefStr="https://wbgame-demo.jiligames.com/fish3/index.html?ssoKey=1b1dfbc4d7c607b459396fecbe0b715139f9917e&lang=en-US&demo=true&be=moc.semagilij.a-ipabewbw&gameId=32&loginFrom=wb-gaming&gs=moc.semagilij.omed-tols&domain_platform=moc.gnidnawcs.df-tolsbw-tau&domain_gs=semagilij&be=moc.semagilij.a-ipabewbw&apiId=6" />

                <FishingTile _imgStr="./img/fishing/MegaFishing.png"
                             _titleStr="Mega Fishing" />

                <FishingTile _imgStr="./img/fishing/HappyFishing.png"
                             _titleStr="Happy Fishing" />

                <FishingTile _imgStr="./img/fishing/DinosaurTycoon.png"
                             _titleStr="Dinosaur Tycoon" />

                <FishingTile _imgStr="./img/fishing/CrazyHunter.png"
                             _titleStr="Crazy Hunter" />

                <FishingTile _imgStr="./img/fishing/BombingFishing.png"
                             _titleStr="Bombing Fishing" />

                <FishingTile _imgStr="./img/fishing/PlinkoEmpire.png"
                             _titleStr="Plinko Empire" />

                <FishingTile _imgStr="./img/fishing/All-StarFishing.png"
                             _titleStr="All-Star Fishing" />

                <FishingTile _imgStr="./img/fishing/BoomLegend.png"
                             _titleStr="Boom Legend" />

                <FishingTile _imgStr="./img/fishing/SecretTreasure.png"
                             _titleStr="Secret Treasure" />

                <FishingTile _imgStr="./img/fishing/DragonTreasure.png"
                             _titleStr="Dragon Treasure" />

                <FishingTile _imgStr="./img/fishing/DragonFortune.png"
                             _titleStr="Dragon Fortune" />
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#card-linkHeader").addClass("active");
    });
</script>
