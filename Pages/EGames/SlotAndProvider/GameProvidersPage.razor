@page "/GameProviders"
@using GoPlayAsiaWebApp.Controls.GameProviderSelectors
@using GoPlayAsiaWebApp.Controls.HeaderAndFooter
@using GoPlayAsiaWebApp.Goplay.Shared.Popup
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames
@using GoPlayAsiaWebApp.Pages.EGames.GamesList
@inject LobbyViewModel lobbyViewModel
@implements IDisposable;

<PageTitle>GoPlayAsia: Game Providers</PageTitle>



<div class="container-fluid marketing">
    <div id="hp-8" class="container-fluid pt-4">
        @if (lobbyViewModel.AllGameList != null)
        {
            <CascadingValue Value="@lobbyViewModel.AllGameList">
                <GameProviderSelectors />
            </CascadingValue>
        }
    </div>
    <GuesBottomNavbar _hrefLiveGameStr="GameProviders#liveGames"
                      _hrefSlotGameStr="GameProviders#slotGames"
                      _hrefCasinoGameStr="GameProviders#cardGames"
                      _hrefArcadeGameStr="GameProviders#arcadeGames" />
</div>
@code{
    [CascadingParameter]
    public IModalService popupModal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (lobbyViewModel.AllGameList == null)
        {
            var popupRef = popupModal.Show<PopupLoading>("");
            await lobbyViewModel.GetListGames();
            popupRef.Close();
        }
        lobbyViewModel.Notify += OnNotify;
    }
    public async void OnNotify()
    {
        await InvokeAsync(() => StateHasChanged());
    }
    public void Dispose()
    {
        lobbyViewModel.Notify -= OnNotify;
    }
}