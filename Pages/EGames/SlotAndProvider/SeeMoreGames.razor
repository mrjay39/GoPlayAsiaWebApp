@page "/GameProviders/More/{gameType}/{activeProvider}"
@using GoPlayAsiaWebApp.Goplay.Shared.Popup
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames
@using GoPlayAsiaWebApp.Controls.GameProviderSelectors
@using GoPlayAsiaWebApp.Pages.EGames.SlotAndProvider
@inject LobbyViewModel lobbyViewModel
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>GoPlayAsia: More Games</PageTitle>



<div class="container-fluid marketing">

    <div id="hp-8" class="container-fluid pt-4">
        @if (lobbyViewModel.AllGameList != null && !string.IsNullOrEmpty(gameType) && !string.IsNullOrEmpty(activeProvider))
        {
            <CascadingValue Value="@lobbyViewModel.AllGameList">
                <GameProviderFilter gameType="@gameType" activeProvider="@activeProvider" />
            </CascadingValue>
        }
    </div>
</div>
@code {
    [Parameter]
    public string gameType { get; set; }
    [Parameter]
    public string activeProvider { get; set; }
    [CascadingParameter]
    public IModalService popupModal { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (lobbyViewModel.AllGameList == null)
        {
            var popupRef = popupModal.Show<PopupLoading>("");
            await lobbyViewModel.GetListGames();
            popupRef.Close();
        }
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;

        if (user.Identity.IsAuthenticated)
        {
            lobbyViewModel.ConnectSignalR();
        }
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        lobbyViewModel.Notify += OnNotify;
    }
    public async void OnNotify()
    {
        await InvokeAsync(() => StateHasChanged());
    }
    public void Dispose()
    {
        lobbyViewModel.Notify -= OnNotify;
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
    }
    private async void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        var user = authState.User;

        if (user.Identity.IsAuthenticated)
        {
            lobbyViewModel.ConnectSignalR();

        }

    }
}