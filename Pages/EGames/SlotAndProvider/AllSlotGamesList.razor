@page "/AllSlotGames"
@using GoPlayAsiaWebApp.Controls.GameSlotProvider
@using GoPlayAsiaWebApp.Controls.HeaderAndFooter
@using GoPlayAsiaWebApp.Goplay.Shared.Popup
@using GoPlayAsiaWebApp.Goplay.ViewModels
@using GoPlayAsiaWebApp.Pages.EGames
@using GoPlayAsiaWebApp.Pages.EGames.GamesList.GameSlotList
@using GoPlayAsiaWebApp.Pages.EGames.SlotAndProvider
@inject LobbyViewModel lobbyViewModel
<PageTitle>GoPlayAsia: Slot Games</PageTitle>



<div class="container-fluid marketing">

    <div id="hp-8" class="container-fluid pt-4">
        @if (lobbyViewModel.AllGameList != null)
        {
            <CascadingValue Value="@lobbyViewModel.AllGameList">
                <GameProviderSlots />
            </CascadingValue>
        }
    </div>

    <GuesBottomNavbar _hrefLiveGameStr="GameProviders/More/Live/All"
                      _hrefSlotGameStr="GameProviders/More/Slots/All"
                      _hrefCasinoGameStr="GameProviders/More/Casino/All"
                      _hrefArcadeGameStr="GameProviders/More/Arcade/All" />
</div>
@code {
    [CascadingParameter]
    public IModalService popupModal { get; set; }
    protected override async Task OnInitializedAsync()
    {
        if (lobbyViewModel.AllGameList == null)
        {
            var popupRef = popupModal.Show<PopupLoading>("");
            await lobbyViewModel.GetListGames();
            popupRef.Close();
        }

        lobbyViewModel.Notify += OnNotify;
    }
    public async void OnNotify()
    {
        await InvokeAsync(() => StateHasChanged());
    }
    public void Dispose()
    {
        lobbyViewModel.Notify -= OnNotify;
    }
}