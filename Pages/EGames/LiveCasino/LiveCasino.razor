@using GoplayasiaSharedKernel.DTOs.DTOIn

<div id="liveGames" class="container">
    <h2 class="text-white fw-bold mt-5">Live Casino</h2>
    <h5 class="text-muted">Your Seat Awaits: Dive into Live Casino Bliss</h5>
    <div class="pb-4 gameOverflow-x">
        <div class="row justify-content-center p-2">

            @foreach (var item in LiveGameList)
            {
                <LiveCasinoTile _imgStr="@item.FileName"
                                _titleStr="@item.TableName" />
            }

        </div>
    </div>
</div>

@code {
    [CascadingParameter] public List<EvolutionGamesDTO> LiveGameList { get; set; }
}