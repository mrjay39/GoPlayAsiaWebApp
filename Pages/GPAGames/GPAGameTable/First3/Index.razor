@page "/First3Table"
@using GoPlayAsiaWebApp.Controls.GameLinkHeader

<div id="first3Tables" class="container-fluid p-0 pb-4 marketing">
    <div class="container pt-4">
        <h2 class="text-white fw-bold mt-4">Pick the Perfect Table for You</h2>
        <h6 class="text-muted">Claim Your Perfect Spot Now!</h6>
        <div id="gpa-overflow" class="pb-2 gameOverflow-x">
            <div class="justify-content-center p-2">
                <First3TableTile 
                    _imgStr="/img/GPAGames/BG-F3.png"
                    _gamePlayHrefStr="games/first3"
                    _gamePromptStr="Can you conquer this table? Give it a try!"
                    _tableNumberStr="First3 Table 1" />

                <First3TableTile _imgStr="/img/GPAGames/BG-F3-2.png"
                    _gamePlayHrefStr="games/first3b"
                    _gamePromptStr="Test your strategy on this table."
                    _tableNumberStr="First3 Table 2" />
            </div>
        </div>
    </div>
</div>
